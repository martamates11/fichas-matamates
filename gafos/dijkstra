  html += `
        </tbody>
      </table>
      <div class="hint">🎉 ¡Enhorabuena! Has completado el algoritmo de Dijkstra. Las rutas en color verde en el grafo muestran los caminos mínimos.</div>
    </div>
  `;
  
  panel.innerHTML = html;
}

let accionPendiente = null;

function pedirConfirmacion(tipo){
  accionPendiente = tipo;
  const titulo = document.getElementById('confirm-titulo');
  const subtitulo = document.getElementById('confirm-subtitulo');
  if(tipo === 'reiniciar'){
    titulo.textContent = '¿Reiniciar todo y generar un nuevo grafo?';
    subtitulo.textContent = 'Se perderá el progreso actual (puntuación, aciertos y fallos).';
    document.getElementById('confirm-overlay').style.display = 'flex';
  } else {
    if(isFinalized){ alert('Ya finalizado.'); return; }
    titulo.textContent = '¿Finalizar y calificar?';
    subtitulo.textContent = 'No podrás modificar los ejercicios.';
    document.getElementById('confirm-overlay').style.display = 'flex';
  }
}
function confirmarAccionPendiente(){
  closeConfirm();
  if(accionPendiente === 'reiniciar') resetGlobalScore();
  else if(accionPendiente === 'finalizar') proceedToFinalize();
  accionPendiente = null;
}
function resetGlobalScore() {
  score=0; aciertos=0; fallos=0; isFinalized=false;
  document.getElementById('score-pts').textContent='0';
  document.getElementById('score-ok').textContent='0';
  document.getElementById('score-fail').textContent='0';
  generarNuevoEjercicio();
}
function closeConfirm(){ document.getElementById('confirm-overlay').style.display='none'; }
function proceedToFinalize(){
  closeConfirm(); isFinalized=true; const name=document.getElementById('name-field').value.trim();
  if(!name){ alert('Escribe tu nombre.'); isFinalized=false; return; }
  const nota=Math.min(10,Math.max(0,score)); const now=new Date(); const fecha=now.toLocaleDateString('es-ES'); const hora=now.toLocaleTimeString('es-ES');
  let bg, col;
  if(nota>=10){bg='#1a7a1a';col='white';}
  else if(nota>=9){bg='#6dbf6d';col='white';}
  else if(nota>=8){bg='#1a4f8a';col='white';}
  else if(nota>=7){bg='#5b9bd5';col='white';}
  else if(nota>=6){bg='#c05c00';col='white';}
  else if(nota>=5){bg='#f5a623';col='black';}
  else {bg='#c0392b';col='white';}
  const box=document.getElementById('modal-box'); box.style.background=bg; box.style.color=col;
  document.getElementById('modal-title').textContent=name; document.getElementById('modal-nota').textContent=nota.toFixed(1)+'/10';
  document.getElementById('modal-data').innerHTML=`<div>📅 ${fecha} ${hora}</div><div>✅ Aciertos: ${aciertos} ❌ Fallos: ${fallos}</div>`;
  document.getElementById('modal-overlay').style.display='flex';
}
function closeResultModal(){ document.getElementById('modal-overlay').style.display='none'; }

document.getElementById('panel-container').addEventListener('keydown', function(e){
  if(e.key === 'Enter'){
    const btn = document.querySelector('#panel-container .btn-primary');
    if(btn && !btn.disabled){ e.preventDefault(); btn.click(); }
  }
});

generarNuevoEjercicio();
