        function iniciarCanvas(){
            let cont = document.getElementById('contenedorGrafoCanvas');
            cont.innerHTML = '';
            let canvas = document.createElement('canvas');
            canvas.width = 650; canvas.height = 380;
            canvas.style.border = '1px solid #C9A96E'; canvas.style.borderRadius = '10px';
            canvas.style.touchAction = "manipulation";
            cont.appendChild(canvas);
            grafoConst.canvas = canvas;
            grafoConst.ctx = canvas.getContext('2d');
            grafoConst.vertices = problem.talleres.map(t=>t.inicial).sort();
            grafoConst.aristas = [];
            let w=canvas.width, h=canvas.height, cx=w/2, cy=h/2, rad=Math.min(w,h)/3.2;
            grafoConst.posiciones = {};
            grafoConst.vertices.forEach((v,i)=>{ let ang=(2*Math.PI*i)/grafoConst.vertices.length - Math.PI/2; grafoConst.posiciones[v]={x: cx + rad*Math.cos(ang), y: cy + rad*Math.sin(ang), radio: 32}; });
            
            const getTouchCoord = (e) => {
                let rect = canvas.getBoundingClientRect();
                let scaleX = canvas.width/rect.width, scaleY = canvas.height/rect.height;
                let clientX, clientY;
                if(e.touches) { clientX = e.touches[0].clientX; clientY = e.touches[0].clientY; }
                else { clientX = e.clientX; clientY = e.clientY; }
                return { x: (clientX - rect.left)*scaleX, y: (clientY - rect.top)*scaleY };
            };
            
            const manejarClick = (e) => {
                e.preventDefault();
                let {x,y} = getTouchCoord(e);
                let v = null;
                for(let vert of grafoConst.vertices){
                    let p = grafoConst.posiciones[vert];
                    if(Math.hypot(x-p.x, y-p.y) <= p.radio) { v = vert; break; }
                }
                if(!v){ grafoConst.vertSel = null; dibujarCanvas(); return; }
                if(grafoConst.vertSel === null){ grafoConst.vertSel = v; dibujarCanvas(); return; }
                let v1 = grafoConst.vertSel, v2 = v;
                if(v1===v2){ grafoConst.vertSel=null; dibujarCanvas(); return; }
                let existe = grafoConst.aristas.some(a=>(a.v1===v1&&a.v2===v2)||(a.v1===v2&&a.v2===v1));
                if(!existe){
                    let comparten = problem.areaInscritos[v1].some(p=>problem.areaInscritos[v2].includes(p));
                    if(comparten){ grafoConst.aristas.push({v1,v2}); document.getElementById('feedbackGrafo').innerHTML='<div class="feedback-correcto">✓ Arista añadida</div>'; }
                    else document.getElementById('feedbackGrafo').innerHTML=`<div class="feedback-incorrecto">✗ ${v1} y ${v2} no comparten inscritos</div>`;
                } else document.getElementById('feedbackGrafo').innerHTML='<div class="feedback-incorrecto">✗ Arista ya existe</div>';
                grafoConst.vertSel = null;
                dibujarCanvas();
            };
            
            canvas.addEventListener('click', manejarClick);
            canvas.addEventListener('touchstart', (e) => { e.preventDefault(); manejarClick(e); });
            canvas.addEventListener('contextmenu', (e) => { e.preventDefault();
                let rect = canvas.getBoundingClientRect();
                let sx = canvas.width/rect.width, sy = canvas.height/rect.height;
                let x = (e.clientX - rect.left)*sx, y = (e.clientY - rect.top)*sy;
                for(let i=0;i<grafoConst.aristas.length;i++){
                    let a=grafoConst.aristas[i];
                    let p1=grafoConst.posiciones[a.v1], p2=grafoConst.posiciones[a.v2];
                    let A=x-p1.x,B=y-p1.y,C=p2.x-p1.x,D=p2.y-p1.y;
                    let dot=A*C+B*D, len2=C*C+D*D;
                    let t = len2===0 ? -1 : dot/len2;
                    let xx,yy;
                    if(t<0){ xx=p1.x; yy=p1.y; } else if(t>1){ xx=p2.x; yy=p2.y; } else{ xx=p1.x+t*C; yy=p1.y+t*D; }
                    if(Math.hypot(x-xx,y-yy)<15){ grafoConst.aristas.splice(i,1); dibujarCanvas(); document.getElementById('feedbackGrafo').innerHTML='<div class="feedback-correcto">🗑️ Arista eliminada</div>'; return; }
                }
            });
            dibujarCanvas();
        }
        
        function dibujarCanvas(){
            let ctx=grafoConst.ctx, canvas=grafoConst.canvas;
            ctx.fillStyle='#FAF6ED'; ctx.fillRect(0,0,canvas.width,canvas.height);
            for(let a of grafoConst.aristas){
                let p1=grafoConst.posiciones[a.v1], p2=grafoConst.posiciones[a.v2];
                ctx.beginPath(); ctx.moveTo(p1.x,p1.y); ctx.lineTo(p2.x,p2.y);
                ctx.strokeStyle='#7B5F3A'; ctx.lineWidth=4; ctx.stroke();
            }
            for(let v of grafoConst.vertices){
                let p=grafoConst.posiciones[v];
                let sel = v===grafoConst.vertSel;
                ctx.fillStyle= sel ? '#A0522D' : '#FDFAF3';
                ctx.strokeStyle= sel ? '#7B3B1E' : '#B48C48';
                ctx.beginPath(); ctx.arc(p.x,p.y,p.radio,0,2*Math.PI); ctx.fill(); ctx.stroke();
                ctx.fillStyle= sel ? 'white' : '#2C1F0E';
                ctx.font='bold 18px Lato'; ctx.textAlign='center'; ctx.textBaseline='middle';
                ctx.fillText(v,p.x,p.y);
            }
        }

        function validarGrafo(){
            if(document.getElementById('btnVerificarGrafo').disabled) return;
            let correctas = new Set(), verts = grafoConst.vertices;
            for(let i=0;i<verts.length;i++) for(let j=i+1;j<verts.length;j++) if(problem.areaInscritos[verts[i]].some(p=>problem.areaInscritos[verts[j]].includes(p))) correctas.add(`${verts[i]}-${verts[j]}`);
            let dibujadas = new Set(); grafoConst.aristas.forEach(a=> dibujadas.add([a.v1,a.v2].sort().join('-')));
            let ok = true;
            for(let c of correctas) if(!dibujadas.has(c)) ok=false;
            for(let d of dibujadas) if(!correctas.has(d)) ok=false;
            if(ok){
                document.getElementById('feedbackGrafo').innerHTML='<div class="feedback-correcto">✅ Grafo correcto.</div>';
                let nuevo={}; verts.forEach(v=>nuevo[v]=[]);
                grafoConst.aristas.forEach(a=>{ nuevo[a.v1].push(a.v2); nuevo[a.v2].push(a.v1); });
                verts.forEach(v=>nuevo[v].sort());
                problem.grafo = nuevo;
                verts.forEach(v=> problem.grados[v] = nuevo[v].length);
                puntos.grafo = 2; // asignación fija, no suma: repetir esta validación nunca duplica puntos
                recalcularPuntuacion();
                document.getElementById('btnVerificarGrafo').disabled = true;
                setTimeout(()=> irAEtapa1(), 600);
            } else document.getElementById('feedbackGrafo').innerHTML='<div class="feedback-incorrecto">✗ El grafo no es correcto.</div>';
        }
        
