        function generarCheckboxes(dias){
            let cont = document.getElementById('tablaAgrupacionContainer');
            let talleres = problem.talleres.map(t=> ({nombre:t.nombre, ini:t.inicial}));
            let html = '<table class="tabla-datos"><thead><tr><th>Día</th><th>Color</th><th>Talleres</th></tr></thead><tbody>';
