            let msg = estadoColor.paso === 'seleccionar' ? 'Toca el vértice de MAYOR GRADO sin colorear.' : (estadoColor.paso === 'elegir' ? `Elige un COLOR para ${estadoColor.vertice}.` : `Toca vértices NO ADYACENTES a ${estadoColor.vertice}. Luego "Completar paso".`);
