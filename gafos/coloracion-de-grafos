                let color = document.getElementById(`colorSelect_${i}`).value;
                document.querySelectorAll(`#lista_${i} input:checked`).forEach(cb=>{ if(asign[cb.value]){ document.getElementById('feedbackConclusion').innerHTML='<div class="feedback-incorrecto">❌ Taller repetido.</div>'; } asign[cb.value] = color; });
            }
            let todos = problem.talleres.map(t=>t.inicial);
            for(let t of todos) if(!asign[t]){ document.getElementById('feedbackConclusion').innerHTML='<div class="feedback-incorrecto">❌ Faltan talleres.</div>'; return; }
