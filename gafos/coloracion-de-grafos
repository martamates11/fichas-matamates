                html += `<tr><td style="font-weight:bold">Día ${i+1}</td>
                          <td><select id="colorSelect_${i}" style="width:120px">${coloresDisponibles.map((hex,idx)=>`<option value="${hex}">${nombresColores[idx]}</option>`).join('')}</select></td>
                          <td><div class="lista-checkbox" id="lista_${i}">`;
                for(let t of talleres) html += `<label><input type="checkbox" value="${t.ini}"> ${t.nombre} (${t.ini})</label>`;
                html += `</div><button class="btn-primario" style="padding:6px 12px" onclick="window.marcarTodos(${i})">✓ Todos</button> <button class="btn-primario" style="padding:6px 12px" onclick="window.deseleccionarTodos(${i})">✗ Ninguno</button></td></tr>`;
            }
