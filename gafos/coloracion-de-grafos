        function clicNodo(v){
            if(estadoColor.paso === 'seleccionar'){
                if(problem.coloracion[v] !== null){ document.getElementById('feedbackColor').innerHTML='<div class="feedback-incorrecto">⚠️ Ya coloreado.</div>'; return; }
                let sinColor = Object.keys(problem.grados).filter(x=>problem.coloracion[x]===null);
                if(sinColor.length===0) return;
                let maxG = Math.max(...sinColor.map(x=>problem.grados[x]));
                if(problem.grados[v] !== maxG){
                    let circle = svgActual?.querySelector(`g[data-vertice="${v}"] circle`);
                    if(circle) circle.classList.add('shake-node');
                    setTimeout(()=> circle?.classList.remove('shake-node'),300);
                    restar();
                    document.getElementById('feedbackColor').innerHTML = `<div class="feedback-incorrecto">❌ Elige grado máximo (${maxG}). -1 punto</div>`;
                    return;
                }
                estadoColor.vertice = v; estadoColor.paso = 'elegir'; actMensaje();
                document.getElementById('feedbackColor').innerHTML = `<div class="feedback-info">✅ Seleccionado ${v} (grado ${problem.grados[v]}). Elige color.</div>`;
                return;
            }
            if(estadoColor.paso === 'noAdy'){
                if(problem.coloracion[v] !== null){ document.getElementById('feedbackColor').innerHTML='<div class="feedback-incorrecto">⚠️ Ya coloreado.</div>'; return; }
                if(problem.grafo[estadoColor.vertice].includes(v)){
                    let circle = svgActual?.querySelector(`g[data-vertice="${v}"] circle`);
                    if(circle) circle.classList.add('shake-node');
                    setTimeout(()=> circle?.classList.remove('shake-node'),300);
                    restar();
                    document.getElementById('feedbackColor').innerHTML = `<div class="feedback-incorrecto">❌ ${v} es ADYACENTE. -1 punto</div>`;
                    return;
                }
                problem.coloracion[v] = estadoColor.color;
                recalcularPuntuacion();
                actualizarColoreo();
                document.getElementById('feedbackColor').innerHTML = `<div class="feedback-correcto">✅ ${v} coloreado igual.</div>`;
                let ady = problem.grafo[estadoColor.vertice];
                estadoColor.noAdy = Object.keys(problem.grados).filter(x=> x!==estadoColor.vertice && problem.coloracion[x]===null && !ady.includes(x));
                actMensaje();
            }
        }

        function selecColor(hex){
            if(estadoColor.paso !== 'elegir'){ document.getElementById('feedbackColor').innerHTML='<div class="feedback-incorrecto">❌ Primero selecciona vértice.</div>'; return; }
            estadoColor.color = hex; estadoColor.paso = 'noAdy';
            problem.coloracion[estadoColor.vertice] = hex;
            recalcularPuntuacion();
            actualizarColoreo(); actMensaje();
            document.getElementById('feedbackColor').innerHTML = `<div class="feedback-info">🎨 Color aplicado. Toca vértices NO ADYACENTES.</div>`;
