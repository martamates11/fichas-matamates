            document.querySelectorAll('#etapa3 .contenedor-grafo').forEach(el => el.remove());
            ['badge0','badge1','badge2','badge3'].forEach(id => document.getElementById(id).classList.remove('activa','completada'));
            document.getElementById('badge0').classList.add('activa');
            ['etapa1','etapa2','etapa3'].forEach(id => document.getElementById(id).style.display = 'none');
            document.getElementById('etapa0').style.display = 'block';
            generarProblemaSeguro();
            renderEtapa0();
        }

        window.onload = ()=>{
            generarProblemaSeguro();
            renderEtapa0();
            document.getElementById('btnVerificarGrafo').onclick = validarGrafo;
            document.getElementById('btnValidarGrados').onclick = validarGrados;
            document.getElementById('btnFinalizarFicha').onclick = aviso;
            document.getElementById('btnNuevaFicha').onclick = reiniciarFicha;
            document.getElementById('confirmarAviso').onclick = finYMostrar;
            document.getElementById('cancelarAviso').onclick = cerrarAviso;
            document.getElementById('cerrarModalBtn').onclick = cerrarModal;
            document.getElementById('overlayModal').onclick = ()=>{ cerrarAviso(); cerrarModal(); };
            document.getElementById('nombreAlumno').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); validarNombre(); e.target.blur(); } });
            document.getElementById('respuestaDias').addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); document.getElementById('btnGenerarTabla').click(); } });
        };
    })();
</script>
</body>
</html>
