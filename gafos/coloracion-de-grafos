            window.deseleccionarTodos = (d)=>{ document.querySelectorAll(`#lista_${d} input`).forEach(c=>c.checked=false); };
        }

        function validarCheck(){
            let dias = parseInt(document.getElementById('respuestaDias').value);
            if(dias !== coloresUsados.length){ document.getElementById('feedbackConclusion').innerHTML='<div class="feedback-incorrecto">❌ Número de días incorrecto.</div>'; return; }
