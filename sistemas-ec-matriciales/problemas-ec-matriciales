      <div class="respuesta">${resp}</div>
      <div class="fb" id="fb-res" aria-live="polite"></div>
      <div class="acciones"><button type="button" class="btn-primario" id="btn-res">Comprobar respuesta</button><span class="msg-paso" id="msg-res" aria-live="polite"></span></div>
