  width: 230px; max-width: 60vw; outline: none;
}
.barra input#nombre:focus { border-color: var(--color-acento); }
.barra input#nombre.falta { border-color: var(--color-incorrecto); box-shadow: 0 0 0 3px rgba(139, 26, 26, .18); }
.barra .dato { color: var(--color-texto-suave); white-space: nowrap; }
.barra .dato b { color: var(--color-acento); font-family: 'Libre Baskerville', serif; }
.aviso-nombre { color: var(--color-incorrecto); font-size: .82rem; font-weight: 700; display: none; width: 100%; text-align: center; }
.aviso-nombre.visible { display: block; }

