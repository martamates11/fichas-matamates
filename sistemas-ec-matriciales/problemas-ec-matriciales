  const bruta = sextos() / 6 - state.fallos * PENALIZACION;
  return Math.round(Math.min(10, Math.max(0, bruta)) * 100) / 100;
}
function sumar(tipo, s) {
  const add = Math.max(0, Math.min(s, OBJETIVO - sextos()));
  prob.h[tipo] += add;
  if (sextos() >= OBJETIVO) state.superada = true;
  return add;
}
function registrarFallo() { prob.h.fallos++; state.fallos++; actualizarMarcador(); }
function actualizarMarcador() {
  document.getElementById('m-nota').textContent = fmt2(calcularNota());
  document.getElementById('m-puntos').textContent = fmt2(sextos() / 6);
  document.getElementById('m-problemas').textContent = state.hist.filter(h => h.estado === 'completo').length;
  document.getElementById('m-fallos').textContent = state.fallos;
  if (prob) {
    const el = document.getElementById('prob-puntos');
    if (el) el.innerHTML = `Este problema: <b>${fmt2((prob.h.plantS + prob.h.resS) / 6)}</b> / 2,5`;
  }
  document.getElementById('btn-soluciones').disabled = !prob || prob.terminado || state.superada;
}
function siguientePlantilla() {
  if (!bolsa.length) {
    bolsa = shuffle(TPL.map((_, i) => i));
    if (primeraBolsa) {
      const ib = TPL.findIndex(t => t.id === OBLIGATORIA);
      bolsa.splice(bolsa.indexOf(ib), 1);
      bolsa.splice(ri(0, 3), 0, ib);
      primeraBolsa = false;
    } else if (bolsa[0] === ultimo && bolsa.length > 1) bolsa.push(bolsa.shift());
  }
  ultimo = bolsa.shift();
  return TPL[ultimo];
}

/* Nombre del alumno */
const inNombre = document.getElementById('nombre');
function exigirNombre() {
  if (inNombre.value.trim()) { inNombre.classList.remove('falta'); document.getElementById('aviso-nombre').classList.remove('visible'); return true; }
  inNombre.classList.add('falta'); document.getElementById('aviso-nombre').classList.add('visible'); inNombre.focus();
  return false;
}
inNombre.addEventListener('input', () => { if (inNombre.value.trim()) { inNombre.classList.remove('falta'); document.getElementById('aviso-nombre').classList.remove('visible'); } });

/* =========================================================
   Pintado del problema
   ========================================================= */
const $ = id => document.getElementById(id);
function fb(id, clase, html) { const el = $(id); el.className = 'fb ' + clase; el.innerHTML = html; typeset(el); }
function nuevoProblema() {
  const tpl = siguientePlantilla();
  let data = null;
  for (let k = 0; k < 5 && !data; k++) data = tpl.gen();
  if (!data) { console.error('Generador sin resultado:', tpl.id); return nuevoProblema(); }
  prepararDatos(data);
  const h = { n: state.hist.length + 1, nombre: tpl.nombre, plantS: 0, resS: 0, fallos: 0, estado: 'en curso' };
  state.hist.push(h);
  const blank = () => ({ ok: false, first: null, match: null, lastWrong: null });
  prob = { tpl, data, h, map: null, mapLocked: false, fields: [blank(), blank(), blank()], rows: [blank(), blank(), blank()],
    plantOk: false, ordOk: false, resOk: false, resFirst: null, resLastWrong: null, revelado: false, terminado: false };
  pintar();
  actualizarMarcador();
}
function pintar() {
  const d = prob.data;
  const opts = d.mags.map((m, j) => `<option value="${j}">${esc(cap(m.label))}</option>`).join('');
  const resp = d.resp.texto.replace(/\{(\d)\}/g, (_, i) => {
    const lab = d.resp.labels ? d.resp.labels[+i] : d.mags[+i].label;
    return `<input type="text" class="ans" id="ans-${i}" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="${esc(cap(lab))}">`;
  });
  $('zona-problema').innerHTML = `
  <article class="ejercicio-card" id="problema">
    <div class="prob-cabecera">
      <span class="prob-num">Problema ${prob.h.n}</span>
      <span class="chip">${esc(prob.tpl.nombre)}</span>
      <span class="prob-puntos" id="prob-puntos"></span>
    </div>
    <div class="enunciado">${esc(d.enunciado)}</div>

    <fieldset class="paso" id="paso1">
      <legend><span class="num">1</span>Elige las incógnitas</legend>
      <p class="ayuda">Decide qué representa cada letra. Al comprobar el planteamiento, esta elección queda fijada.</p>
      <div class="map-grid">
        ${LET.map((L, i) => `<label class="map-item" for="map-${i}"><span class="var">${L}</span><span class="igual">=</span><select id="map-${i}" class="map-sel"><option value="">— elige —</option>${opts}</select></label>`).join('')}
      </div>
    </fieldset>

    <fieldset class="paso" id="paso2">
      <legend><span class="num">2</span>Plantea el sistema</legend>
      <p class="ayuda">Escribe una ecuación por cada información del enunciado, como tú la pienses. El orden no importa.</p>
      ${[0, 1, 2].map(i => `
      <div class="eq-row">
        <div class="eq-linea">
          <label class="eq-label" for="eq-${i}">Ecuación ${i + 1}</label>
          <input type="text" id="eq-${i}" class="eq-input" autocomplete="off" autocorrect="off" spellcheck="false" autocapitalize="off" placeholder="Escribe la ecuación ${i + 1}">
        </div>
        <div class="preview" id="prev-${i}" aria-live="polite"></div>
        <div class="fb" id="fb-eq-${i}" aria-live="polite"></div>
      </div>`).join('')}
      <div class="acciones"><button type="button" class="btn-primario" id="btn-plant">Comprobar planteamiento</button><span class="msg-paso" id="msg-plant" aria-live="polite"></span></div>
    </fieldset>

    <fieldset class="paso" id="paso3" disabled>
      <legend><span class="num">3</span>Escribe el sistema ordenado</legend>
      <p class="ayuda">Pasa cada ecuación a la forma <i>ax</i> + <i>by</i> + <i>cz</i> = <i>d</i>. Escribe un número en cada casilla: 1 si la incógnita va sola, 0 si no aparece y el signo menos si es negativo. Puedes usar decimales o fracciones (2/3).</p>
      <div class="recordatorio" id="recordatorio"></div>
      ${[0, 1, 2].map(i => `
      <div class="ord-row">
        <span class="ord-n">${i + 1}.</span>
        <input type="text" class="coef" id="c-${i}-0" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Fila ${i + 1}: coeficiente de x"><span class="op"><i>x</i> +</span>
        <input type="text" class="coef" id="c-${i}-1" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Fila ${i + 1}: coeficiente de y"><span class="op"><i>y</i> +</span>
        <input type="text" class="coef" id="c-${i}-2" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Fila ${i + 1}: coeficiente de z"><span class="op"><i>z</i> =</span>
        <input type="text" class="coef" id="c-${i}-3" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" aria-label="Fila ${i + 1}: término independiente">
