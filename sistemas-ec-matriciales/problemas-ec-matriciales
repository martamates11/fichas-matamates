  $('btn-plant').addEventListener('click', comprobarPlanteamiento);
  $('btn-ord').addEventListener('click', comprobarOrdenado);
  $('btn-res').addEventListener('click', comprobarRespuesta);
  for (let i = 0; i < 3; i++) $('eq-' + i).addEventListener('input', () => vistaPrevia(i));
}

/* Vista previa de cada ecuación */
const temporizadores = {};
function vistaPrevia(i) {
  clearTimeout(temporizadores[i]);
  temporizadores[i] = setTimeout(() => {
    const el = $('prev-' + i); if (!el) return;
    const txt = $('eq-' + i).value.trim();
    if (!txt) { el.innerHTML = ''; return; }
    try {
      const r = parseEquation(txt);
      el.innerHTML = `<span class="etq">Se lee</span>${mathSpan(tex(r.lhs) + ' = ' + tex(r.rhs), plain(r.lhs) + ' = ' + plain(r.rhs))}`;
      typeset(el);
    } catch (e) {
      el.innerHTML = `<span class="err">${esc(e instanceof PErr ? e.message : 'No he podido interpretar la ecuación.')}</span>`;
    }
  }, 220);
}

/* Paso 2: planteamiento */
function leerMapa() { return [0, 1, 2].map(i => { const v = $('map-' + i).value; return v === '' ? null : +v; }); }
function comprobarPlanteamiento() {
  if (!prob || prob.terminado || prob.plantOk) return;
  if (!exigirNombre()) return;
  const msg = $('msg-plant'); msg.textContent = '';
  if (!prob.mapLocked) {
    const map = leerMapa();
    if (map.includes(null)) { msg.textContent = 'Primero elige qué representa cada letra (paso 1).'; return; }
    if (new Set(map).size < 3) { msg.textContent = 'Cada letra debe representar una magnitud distinta (paso 1).'; return; }
    prob.map = map; prob.mapLocked = true;
    for (let i = 0; i < 3; i++) { $('map-' + i).disabled = true; $('map-' + i).classList.add('bien'); }
    $('paso1').classList.add('hecho');
  }
  const d = prob.data;
  const tomadas = new Map();
  prob.fields.forEach((f, i) => { if (f.ok) tomadas.set(f.match, `la ecuación ${i + 1}`); });
  let vacias = false;
  prob.fields.forEach((f, i) => {
    if (f.ok) return;
    const inp = $('eq-' + i), txt = inp.value.trim();
    if (!txt) { vacias = true; fb('fb-eq-' + i, 'feedback-aviso', 'Escribe aquí la ecuación.'); return; }
    let r;
    try { r = parseEquation(txt); }
    catch (e) { fb('fb-eq-' + i, 'feedback-aviso', esc(e instanceof PErr ? e.message : 'No he podido interpretar la ecuación.') + ' <i>(No cuenta como fallo.)</i>'); return; }
    const normTxt = txt.replace(/\s+/g, '').toLowerCase();
    if (f.lastWrong !== null && normTxt === f.lastWrong) { fb('fb-eq-' + i, 'feedback-incorrecto', 'No has cambiado esta ecuación: sigue sin ser correcta.'); return; }
    const res = clasificar(r.u, prob.map, d, tomadas, 'libre');
    if (f.first === null) f.first = res.ok;
    if (res.ok) {
      f.ok = true; f.match = res.c; tomadas.set(res.c, `la ecuación ${i + 1}`);
      inp.disabled = true; inp.classList.remove('mal'); inp.classList.add('bien');
      fb('fb-eq-' + i, 'feedback-correcto', `<b>Correcto.</b> Esta ecuación expresa ${esc(d.conds[res.c].desc)}.${f.first ? '' : ' <span style="font-weight:400">(Corregida: ya no puntúa.)</span>'}`);
    } else {
      f.lastWrong = normTxt; inp.classList.add('mal');
      registrarFallo();
      fb('fb-eq-' + i, 'feedback-incorrecto', `<b>Incorrecto.</b> ${esc(res.msg)}${res.pista ? `<span class="pista">${esc(res.pista)}</span>` : ''}`);
    }
  });
  if (vacias && !prob.fields.every(f => f.ok)) msg.textContent = 'Faltan ecuaciones por escribir.';
  if (prob.fields.every(f => f.ok)) {
    prob.plantOk = true;
    $('paso2').classList.add('hecho');
    pintarRecordatorio();
    $('paso3').disabled = false;
    $('c-0-0').focus();
  }
  actualizarMarcador();
}
function pintarRecordatorio() {
  const items = [0, 1, 2].map(i => {
    const r = parseEquation($('eq-' + i).value);
    return mathSpan(tex(r.lhs) + ' = ' + tex(r.rhs), plain(r.lhs) + ' = ' + plain(r.rhs));
  });
  $('recordatorio').innerHTML = `<span class="etq">Tus ecuaciones</span><br>${items.join('<span style="margin:0 14px;color:var(--color-borde)">·</span>')}`;
  typeset($('recordatorio'));
}

/* Paso 3: sistema ordenado */
function leerNumero(txt) {
  let s = String(txt).trim().replace(/[−–]/g, '-').replace(/\s+/g, '').replace(',', '.');
  if (s === '') return null;
  let m = s.match(/^([+-]?)(\d+(?:\.\d+)?)\/(\d+(?:\.\d+)?)$/);
  if (m) { const den = parseFloat(m[3]); if (den === 0) throw new PErr('No se puede dividir entre cero.'); return (m[1] === '-' ? -1 : 1) * parseFloat(m[2]) / den; }
  if (/^[+-]?[1-9]\d{0,2}(\.\d{3})+$/.test(s)) throw new PErr(`«${txt}» parece llevar un punto de miles: escribe el número sin separador (por ejemplo, 54900).`);
  if (/^[+-]?(\d+(\.\d+)?|\.\d+)$/.test(s)) return parseFloat(s);
  throw new PErr(`«${txt}» no es un número válido.`);
}
function comprobarOrdenado() {
  if (!prob || prob.terminado || !prob.plantOk || prob.ordOk) return;
  if (!exigirNombre()) return;
  const d = prob.data;
  const tomadas = new Map();
  prob.rows.forEach((r, i) => { if (r.ok) tomadas.set(r.match, `la fila ${i + 1}`); });
  prob.rows.forEach((rw, i) => {
    if (rw.ok) return;
    const ids = [0, 1, 2, 3].map(j => `c-${i}-${j}`);
    const txts = ids.map(id => $(id).value.trim());
    if (txts.some(t => t === '')) { fb('fb-row-' + i, 'feedback-aviso', 'Completa las cuatro casillas de la fila (escribe 0 si una incógnita no aparece).'); return; }
    let vals;
    try { vals = txts.map(leerNumero); }
    catch (e) { fb('fb-row-' + i, 'feedback-aviso', esc(e.message) + ' <i>(No cuenta como fallo.)</i>'); return; }
    const clave = vals.join('|');
    if (rw.lastWrong !== null && clave === rw.lastWrong) { fb('fb-row-' + i, 'feedback-incorrecto', 'No has cambiado esta fila: sigue sin ser correcta.'); return; }
    const u = [vals[0], vals[1], vals[2], -vals[3]];
    const res = clasificar(u, prob.map, d, tomadas, 'fila');
    if (rw.first === null) rw.first = res.ok;
    if (res.ok) {
      rw.ok = true; rw.match = res.c; tomadas.set(res.c, `la fila ${i + 1}`);
      const fl = prob.fields.find(x => x.match === res.c);
      if (rw.first && fl && fl.first) sumar('plantS', 4); // 2/3 de punto: ecuación libre y fila acertadas a la primera
      ids.forEach(id => { $(id).disabled = true; $(id).classList.remove('mal'); $(id).classList.add('bien'); });
      fb('fb-row-' + i, 'feedback-correcto', `<b>Correcto.</b> Es la ecuación que expresa ${esc(d.conds[res.c].desc)}, ordenada.${rw.first ? '' : ' <span style="font-weight:400">(Corregida: ya no puntúa.)</span>'}`);
    } else {
      rw.lastWrong = clave; ids.forEach(id => $(id).classList.add('mal'));
      registrarFallo();
      fb('fb-row-' + i, 'feedback-incorrecto', `<b>Incorrecto.</b> ${esc(res.msg)}${res.pista ? `<span class="pista">${esc(res.pista)}</span>` : ''}`);
    }
  });
  if (state.superada) { cerrarProblema('completo'); return; }
  if (prob.rows.every(r => r.ok)) {
    prob.ordOk = true;
    $('paso3').classList.add('hecho');
    $('msg-ord').innerHTML = `<span style="color:var(--color-correcto)">Planteamiento terminado: ${fmt2(prob.h.plantS / 6)} de 2 puntos.</span>`;
    $('paso4').disabled = false;
    $('ans-0').focus();
  }
  actualizarMarcador();
}

/* Paso 4: respuesta */
function comprobarRespuesta() {
  if (!prob || prob.terminado || !prob.ordOk || prob.resOk) return;
  if (!exigirNombre()) return;
  const d = prob.data, R = d.resp;
  const n = R.valores.length;
  const txts = [...Array(n)].map((_, i) => $('ans-' + i).value.trim());
  if (txts.some(t => t === '')) { fb('fb-res', 'feedback-aviso', 'Completa todos los huecos de la respuesta.'); return; }
  let vals;
  try { vals = txts.map(leerNumero); }
  catch (e) { fb('fb-res', 'feedback-aviso', esc(e.message) + ' <i>(No cuenta como fallo.)</i>'); return; }
  const clave = vals.join('|');
  if (prob.resLastWrong !== null && clave === prob.resLastWrong) { fb('fb-res', 'feedback-incorrecto', 'No has cambiado la respuesta: sigue sin ser correcta.'); return; }
  const tol = 0.005;
  const bienCada = vals.map((v, i) => Math.abs(v - R.valores[i]) <= tol + 1e-9);
  const ok = bienCada.every(Boolean);
  if (prob.resFirst === null) prob.resFirst = ok;
  if (ok) {
    prob.resOk = true;
    [...Array(n)].forEach((_, i) => { $('ans-' + i).disabled = true; $('ans-' + i).classList.remove('mal'); $('ans-' + i).classList.add('bien'); });
    fb('fb-res', 'feedback-correcto', `<b>Correcto.</b> Estos valores cumplen las tres ecuaciones del sistema, así que son la solución.${prob.resFirst ? '' : ' <span style="font-weight:400">(Corregida: ya no puntúa.)</span>'}`);
    if (prob.resFirst) sumar('resS', 3);
    $('paso4').classList.add('hecho');
    cerrarProblema('completo');
    return;
  }
  prob.resLastWrong = clave;
  [...Array(n)].forEach((_, i) => $('ans-' + i).classList.toggle('mal', !bienCada[i]));
  registrarFallo();
  fb('fb-res', 'feedback-incorrecto', `<b>Incorrecto.</b> ${diagnosticoRespuesta(vals, bienCada)}`);
}
function diagnosticoRespuesta(vals, bienCada) {
  const d = prob.data, R = d.resp;
  if (vals.length > 1) {
    const a = vals.map(v => Math.round(v * 1000)).sort((p, q) => p - q), b = R.valores.map(v => Math.round(v * 1000)).sort((p, q) => p - q);
    if (a.every((v, i) => v === b[i])) return 'Los valores son los de la solución, pero están cambiados de sitio. Fíjate en qué representa cada letra: ' + esc(LET.map((L, i) => `${L} es ${d.mags[prob.map[i]].label}`).join('; ')) + '.';
  }
  const solAl = R.toSol ? R.toSol(vals) : vals;
  if (!solAl) return 'El número buscado tiene tres cifras. Construye el número a partir de las cifras que te da la calculadora.';
  const fallan = [];
  d.conds.forEach(cd => {
    const lhs = dot(cd.canon.v, solAl);
    if (Math.abs(lhs - cd.canon.k) > 1e-6 * Math.max(1, Math.abs(cd.canon.k))) {
      const c = toLet(cd.canon.v, prob.map);
      fallan.push(`en ${mathSpan(linTex(c, cd.canon.k), linPlain(c, cd.canon.k))} el primer miembro da ${fmt(lhs)} en lugar de ${fmt(cd.canon.k)}`);
    }
  });
  const marcados = vals.length > 1 ? 'Los huecos marcados en rojo no son correctos. ' : '';
  return `${marcados}Comprueba sustituyendo: ${fallan.length ? fallan.join('; ') : 'algún valor no cumple el sistema'}. Revisa cómo has introducido los coeficientes en la calculadora (signos, ceros y orden de las incógnitas) y en qué hueco va cada valor.`;
}

/* Cierre del problema */
function cerrarProblema(estado) {
  prob.terminado = true;
  prob.h.estado = estado;
  if (prob.tpl.id === OBLIGATORIA) {
    if (estado === 'completo') obligatoriaHecha = true;
    else if (!obligatoriaHecha && !state.superada) {
      const ib = TPL.findIndex(t => t.id === OBLIGATORIA);
      const pos = bolsa.indexOf(ib);
      if (pos >= 0) bolsa.splice(pos, 1);
      bolsa.splice(Math.min(ri(1, 2), bolsa.length), 0, ib);
    }
  }
  ['paso1', 'paso2', 'paso3', 'paso4'].forEach(id => { $(id).disabled = true; });
  const d = prob.data;
  const map = prob.map || [0, 1, 2];
  const filas = d.conds.map(cd => linTex(toLet(cd.canon.v, map), cd.canon.k));
  const solTxt = d.resp.texto.replace(/\{(\d)\}/g, (_, i) => `<b>${fmt(d.resp.valores[+i])}</b>`);
  const pl = fmt2(prob.h.plantS / 6), rs = fmt2(prob.h.resS / 6);
  const neutro = estado === 'soluciones';
  $('prob-resultado').innerHTML = `
    <div class="resultado ${neutro ? 'neutro' : ''}">
      <h4>${neutro ? 'Soluciones mostradas · lo que quedaba del problema no puntúa' : 'Problema terminado'}</h4>
      <p class="linea">Planteamiento: <b>${pl}</b> / 2 · Resultado: <b>${rs}</b> / 0,5 · Fallos en este problema: <b>${prob.h.fallos}</b></p>
      <div class="sistema">${mathSpan('\\begin{cases} ' + filas.join(' \\\\ ') + ' \\end{cases}', filas.map(f => f.replace(/\{,\}/g, ',')).join(' ; '))}</div>
      <p class="linea">${solTxt}</p>
      ${state.superada ? '' : '<div class="acciones" style="justify-content:center"><button type="button" class="btn-primario" id="btn-sig">Siguiente problema</button></div>'}
    </div>
    ${state.superada ? `<div class="banner-fin">Has reunido los 10 puntos de la ficha. Pulsa «Finalizar y Calificar» para ver tu informe.</div>` : ''}`;
  typeset($('prob-resultado'));
  const sig = $('btn-sig');
  if (sig) { sig.addEventListener('click', () => { nuevoProblema(); $('problema').scrollIntoView({ behavior: 'smooth', block: 'start' }); }); sig.focus(); }
  actualizarMarcador();
}

/* =========================================================
   Mostrar soluciones
   ========================================================= */
const ovSol = $('ov-soluciones');
function abrirAvisoSoluciones() {
  if (!prob || prob.terminado || state.superada) return;
  ovSol.classList.add('visible'); $('btn-sol-no').focus();
}
function cerrarAvisoSoluciones() { ovSol.classList.remove('visible'); }
$('btn-soluciones').addEventListener('click', abrirAvisoSoluciones);
$('btn-sol-no').addEventListener('click', cerrarAvisoSoluciones);
ovSol.addEventListener('click', e => { if (e.target === ovSol) cerrarAvisoSoluciones(); });
$('btn-sol-si').addEventListener('click', () => { cerrarAvisoSoluciones(); revelarSoluciones(); });
function revelarSoluciones() {
  if (!prob || prob.terminado || state.superada) return;
  const d = prob.data;
  if (!prob.mapLocked) {
    let map = leerMapa();
    if (map.includes(null) || new Set(map).size < 3) map = [0, 1, 2];
    prob.map = map; prob.mapLocked = true;
    map.forEach((v, i) => { $('map-' + i).value = String(v); $('map-' + i).disabled = true; $('map-' + i).classList.add('revelado'); });
  }
  const nat = c => d.conds[c].nat.replace(/\$(\d)/g, (_, i) => LET[prob.map.indexOf(+i)]);
  // Planteamiento pendiente
  if (!prob.plantOk) {
    const tomadas = new Map();
    prob.fields.forEach((f, i) => { if (f.ok) tomadas.set(f.match, `la ecuación ${i + 1}`); });
    const libres = [0, 1, 2].filter(c => !tomadas.has(c));
    prob.fields.forEach((f, i) => {
      if (f.ok) return;
      const c = libres.shift(), inp = $('eq-' + i);
      inp.value = nat(c); vistaPrevia(i);
      const res = clasificar(parseEquation(inp.value).u, prob.map, d, tomadas, 'libre');
      inp.disabled = true; inp.classList.remove('mal'); inp.classList.add('revelado');
      if (res.ok) { tomadas.set(res.c, `la ecuación ${i + 1}`); f.match = res.c; fb('fb-eq-' + i, 'feedback-solucion', `<b>Solución.</b> Esta ecuación expresa ${esc(d.conds[res.c].desc)}.`); }
      else { console.error('Validador no acepta su solución', prob.tpl.id, inp.value); fb('fb-eq-' + i, 'feedback-incorrecto', '<b>Incorrecto.</b> ' + esc(res.msg)); }
      f.revelado = true;
    });
    pintarRecordatorio();
  }
  // Sistema ordenado pendiente
  if (!prob.ordOk) {
    const tomadas = new Map();
    prob.rows.forEach((r, i) => { if (r.ok) tomadas.set(r.match, `la fila ${i + 1}`); });
    const libres = [0, 1, 2].filter(c => !tomadas.has(c));
    prob.rows.forEach((rw, i) => {
      if (rw.ok) return;
      const c = libres.shift(), cn = d.conds[c].canon, cl = toLet(cn.v, prob.map);
      const vals = [...cl, cn.k];
      vals.forEach((v, j) => { const el = $(`c-${i}-${j}`); el.value = fmt(v); el.disabled = true; el.classList.remove('mal'); el.classList.add('revelado'); });
      const res = clasificar([cl[0], cl[1], cl[2], -cn.k], prob.map, d, tomadas, 'fila');
      if (res.ok) { tomadas.set(res.c, `la fila ${i + 1}`); fb('fb-row-' + i, 'feedback-solucion', `<b>Solución.</b> Es la ecuación que expresa ${esc(d.conds[res.c].desc)}, ordenada.`); }
      else { console.error('Validador no acepta su fila', prob.tpl.id, vals); fb('fb-row-' + i, 'feedback-incorrecto', '<b>Incorrecto.</b> ' + esc(res.msg)); }
    });
  }
  // Respuesta pendiente
  if (!prob.resOk) {
    d.resp.valores.forEach((v, i) => { const el = $('ans-' + i); el.value = fmt(v); el.disabled = true; el.classList.remove('mal'); el.classList.add('revelado'); });
    fb('fb-res', 'feedback-solucion', '<b>Solución.</b> Estos valores cumplen las tres ecuaciones del sistema.');
  }
  prob.revelado = true;
  cerrarProblema('soluciones');
}

/* =========================================================
   Informe final
   ========================================================= */
const ovInf = $('ov-informe');
function colorNota(n) {
  if (n >= 10) return ['#1a7a1a', '#fff'];
  if (n >= 9) return ['#6dbf6d', '#fff'];
  if (n >= 8) return ['#1a4f8a', '#fff'];
  if (n >= 7) return ['#5b9bd5', '#fff'];
  if (n >= 6) return ['#c05c00', '#fff'];
  if (n >= 5) return ['#f5a623', '#000'];
  return ['#c0392b', '#fff'];
}
const dos = n => String(n).padStart(2, '0');
function abrirInforme() {
  if (!exigirNombre()) return;
  const nota = calcularNota();
  const [bg, fg] = colorNota(nota);
  const ahora = new Date();
  const mins = Math.ceil((Date.now() - state.inicio) / 60000);
  const filas = state.hist.map(h => {
    const est = h.estado === 'completo' ? '<span class="estado-completo">Completo</span>' : h.estado === 'soluciones' ? '<span class="estado-soluciones">Soluciones vistas</span>' : '<span class="estado-curso">En curso</span>';
    return `<tr><td>${h.n}</td><td>${esc(h.nombre)}</td><td>${fmt2(h.plantS / 6)} / 2</td><td>${fmt2(h.resS / 6)} / 0,5</td><td>${h.fallos}</td><td>${est}</td></tr>`;
  }).join('');
  const vistos = state.hist.filter(h => h.estado === 'soluciones').length;
  const m = $('modal-informe');
  m.style.background = bg; m.style.color = fg;
  m.innerHTML = `
    <p class="m-titulo" id="m-titulo">${esc(document.querySelector('.titulo-ficha').textContent)}</p>
    <p class="m-sub">${esc(document.querySelector('.subtitulo').textContent)}</p>
    <hr>
    <div class="m-enc">Informe de la actividad</div>
    <p class="m-nombre">${esc(inNombre.value.trim())}</p>
    <div class="m-nota">${fmt2(nota)}<span style="font-size:1.1rem;font-weight:400"> / 10</span></div>
    <div class="m-datos">
      <span>Fecha: ${dos(ahora.getDate())}/${dos(ahora.getMonth() + 1)}/${ahora.getFullYear()}</span>
      <span>Hora: ${dos(ahora.getHours())}:${dos(ahora.getMinutes())}:${dos(ahora.getSeconds())}</span>
      <span>Tiempo empleado: ${dos(Math.floor(mins / 60))}:${dos(mins % 60)}</span>
    </div>
    <div class="panel-informe">
      <div class="resumen-nota">
        <span>Puntos conseguidos: <b>${fmt2(sextos() / 6)}</b> / 10</span>
        <span>Fallos: <b>${state.fallos}</b> (−${fmt2(state.fallos * PENALIZACION)})</span>
        <span>Problemas completos: <b>${state.hist.filter(h => h.estado === 'completo').length}</b></span>
        <span>Soluciones vistas: <b>${vistos}</b></span>
      </div>
      <h4>Desglose por problema</h4>
      <table class="informe">
        <thead><tr><th>N.º</th><th>Problema</th><th>Planteamiento</th><th>Resultado</th><th>Fallos</th><th>Estado</th></tr></thead>
        <tbody>${filas || '<tr><td colspan="6">Sin problemas trabajados.</td></tr>'}</tbody>
      </table>
    </div>
    <button type="button" class="btn-secundario btn-cerrar" id="btn-cerrar-inf" style="background:var(--color-fondo-card)">Cerrar y seguir practicando</button>`;
  $('ficha').classList.toggle('perfecta', nota >= 10);
  ovInf.classList.add('visible');
  $('btn-cerrar-inf').addEventListener('click', () => ovInf.classList.remove('visible'));
  $('btn-cerrar-inf').focus();
}
$('btn-finalizar').addEventListener('click', abrirInforme);
ovInf.addEventListener('click', e => { if (e.target === ovInf) ovInf.classList.remove('visible'); });

/* Teclado: Enter comprueba el paso; Escape cierra modales */
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') { cerrarAvisoSoluciones(); ovInf.classList.remove('visible'); return; }
  if (e.key !== 'Enter') return;
  const t = e.target;
  if (!(t instanceof HTMLElement)) return;
  if (t.classList.contains('eq-input') || t.classList.contains('map-sel')) { e.preventDefault(); comprobarPlanteamiento(); }
  else if (t.classList.contains('coef')) { e.preventDefault(); comprobarOrdenado(); }
  else if (t.classList.contains('ans')) { e.preventDefault(); comprobarRespuesta(); }
});

/* =========================================================
   Autocomprobación para QA (no se usa en clase)
   ========================================================= */
window.__ficha = {
  state, get prob() { return prob; }, get bolsa() { return bolsa; }, TPL, parseEquation, clasificar, prepararDatos, calcularNota,
  selfTest(n = 200) {
    const errores = [];
    TPL.forEach(tp => {
      for (let k = 0; k < n; k++) {
        const d = tp.gen();
        if (!d) { errores.push(`${tp.id}: generador sin resultado`); continue; }
        prepararDatos(d);
        const txt = d.enunciado + d.resp.texto;
        if (/undefined|NaN|Infinity/.test(txt)) errores.push(`${tp.id}: texto con valores no válidos: ${d.enunciado}`);
        if (d.sol.some(x => !isFinite(x) || x < 0)) errores.push(`${tp.id}: solución no válida ${d.sol}`);
        if (Math.abs(det3(d.conds.map(c => c.v))) < 1e-9) errores.push(`${tp.id}: sistema sin solución única`);
        d.conds.forEach((c, ci) => {
          if (!c.forms.every(w => satisface(w, d.sol))) errores.push(`${tp.id}: condición ${ci} no se cumple con la solución`);
          for (const pm of PERMS) {
            const inv = [0, 1, 2].map(L => pm[L]);
            const natL = c.nat.replace(/\$(\d)/g, (_, i) => LET[inv.indexOf(+i)]);
            let r; try { r = parseEquation(natL); } catch (e) { errores.push(`${tp.id}: nat no se analiza: ${natL} (${e.message})`); break; }
            const res = clasificar(r.u, inv, d, new Map(), 'libre');
            if (!res.ok || res.c !== ci) errores.push(`${tp.id}: nat no reconocida: ${natL}`);
            const cl = toLet(c.canon.v, inv);
            const rr = clasificar([cl[0], cl[1], cl[2], -c.canon.k], inv, d, new Map(), 'fila');
            if (!rr.ok || rr.c !== ci) errores.push(`${tp.id}: fila canónica no reconocida`);
          }
        });
        if (d.resp.valores.length !== (d.resp.texto.match(/\{\d\}/g) || []).length) errores.push(`${tp.id}: huecos de respuesta incoherentes`);
      }
    });
    return errores;
  }
};

nuevoProblema();
actualizarMarcador();
</script>
<div class="teclas" id="teclas" role="toolbar" aria-label="Teclas matemáticas">
  <span class="etq-t">Teclas matemáticas</span>
  <button type="button" data-k="-" aria-label="Signo menos">−</button>
  <button type="button" data-k="/" aria-label="Raya de fracción">/</button>
  <button type="button" data-k="," aria-label="Coma decimal">,</button>
  <button type="button" data-k="+" class="solo-eq" aria-label="Más">+</button>
  <button type="button" data-k="=" class="solo-eq" aria-label="Igual">=</button>
  <button type="button" data-k="(" class="solo-eq" aria-label="Abrir paréntesis">(</button>
  <button type="button" data-k=")" class="solo-eq" aria-label="Cerrar paréntesis">)</button>
  <button type="button" data-k="x" class="solo-eq var-k sep">x</button>
  <button type="button" data-k="y" class="solo-eq var-k">y</button>
  <button type="button" data-k="z" class="solo-eq var-k">z</button>
</div>
<script>
/* Teclas matemáticas: en móviles el teclado numérico no trae ni «−» ni «/».
   La barra aparece al enfocar un campo matemático y escribe en la posición del cursor. */
(function () {
  const bar = document.getElementById('teclas');
  const esCampo = el => el && el.matches && el.matches('.eq-input, .coef, .ans') && !el.disabled;
  const tactil = window.matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window;
  let activo = null, ocultar = null;
  document.addEventListener('focusin', e => {
    if (!tactil || !esCampo(e.target)) return;
    clearTimeout(ocultar);
    activo = e.target;
    const eq = activo.classList.contains('eq-input');
    bar.querySelectorAll('.solo-eq').forEach(b => { b.style.display = eq ? '' : 'none'; });
    bar.classList.add('visible'); document.body.classList.add('con-teclas');
  });
  document.addEventListener('focusout', () => {
    ocultar = setTimeout(() => {
      if (!esCampo(document.activeElement)) { bar.classList.remove('visible'); document.body.classList.remove('con-teclas'); activo = null; }
    }, 150);
  });
  // pointerdown + preventDefault: el campo no pierde el foco ni se cierra el teclado
  bar.addEventListener('pointerdown', e => { if (e.target.closest('button')) e.preventDefault(); });
  bar.addEventListener('mousedown', e => e.preventDefault());
  bar.addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b || !activo || activo.disabled) return;
    const k = b.dataset.k;
    const ini = activo.selectionStart ?? activo.value.length, fin = activo.selectionEnd ?? ini;
    activo.setRangeText(k, ini, fin, 'end');
    activo.dispatchEvent(new Event('input', { bubbles: true }));
    activo.focus();
  });
})();
</script>
