function markField(id,ok){const el=document.getElementById(id);if(!el)return;el.classList.remove('ok','fail');el.classList.add(ok?'ok':'fail');}
function markBloque(id,ok){const el=document.getElementById(id);if(!el)return;el.classList.remove('paso-ok','paso-fail');el.classList.add(ok?'paso-ok':'paso-fail');const pnum=el.querySelector('.pnum');if(pnum)pnum.classList.toggle('done',ok);}
function showFb(id,ok,msg){const el=document.getElementById(id);if(!el)return;el.className='fb-paso show '+(ok?'ok':'fail');el.innerHTML=msg;}
function xn(s){
  // Coma decimal española (0,5 -> 0.5) ANTES de tratar la coma como separador de lista
  let str=String(s).replace(/[\u2212\u2013\u2014]/g,'-');
  str=str.replace(/(\d),(\d)/g,'$1.$2');
  str=str.replace(/[,;]/g,' ');
  const vals=[],used=[];
  const fracRe=/(-?\d+)\s*\/\s*(\d+)/g;let m;
  while((m=fracRe.exec(str))!==null){vals.push(parseInt(m[1])/parseInt(m[2]));used.push([m.index,m.index+m[0].length]);}
  const numRe=/-?\d+(\.\d+)?/g;
  while((m=numRe.exec(str))!==null){const s=m.index,e=m.index+m[0].length;if(!used.some(([a,b])=>s>=a&&e<=b))vals.push(Number(m[0]));}
  return vals;
}
function has(arr,v){const tol=Math.max(0.02,Math.abs(v)*0.001)+0.01;return arr.some(n=>Math.abs(n-v)<=tol);}

