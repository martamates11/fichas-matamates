function checkPaso3(){
  startTimer();const e=currentEjT1;let ok=0,tot=0,errMsg='';
  e.intervalos.forEach((iv,i)=>{
    const idx=i+1;const bEl=document.getElementById('ib_'+idx);const aEl=document.getElementById('ia_'+idx);const fbEl=document.getElementById('ifb_'+idx);const faEl=document.getElementById('ifa_'+idx);const vEl=document.getElementById('iv_'+idx);
    if(!bEl||!aEl||!fbEl||!faEl||!vEl){tot+=4;return;}
    const bOk=has(xn(bEl.value),iv.b);const aOk=has(xn(aEl.value),iv.a);
    const Fb=Math.round(primEval(e.coeffs,iv.b)*100)/100;const Fa=Math.round(primEval(e.coeffs,iv.a)*100)/100;
    const fbOk=has(xn(fbEl.value),Fb);const faOk=has(xn(faEl.value),Fa);
    const valR=Math.round(iv.val*100)/100;const valOk=has(xn(vEl.value),valR);
    markField('ib_'+idx,bOk);markField('ia_'+idx,aOk);markField('ifb_'+idx,fbOk);markField('ifa_'+idx,faOk);markField('iv_'+idx,valOk);
    ok+=(bOk&&aOk?1:0)+(fbOk?1:0)+(faOk?1:0)+(valOk?1:0);tot+=4;
    if(!bOk||!aOk||!fbOk||!faOk||!valOk){
      function fmtV(v){if(Number.isInteger(v))return String(v);for(let d=2;d<=12;d++){const n=Math.round(v*d);if(Math.abs(n/d-v)<1e-9){const g=(function gcd(a,b){return b===0?a:gcd(b,a%b);})(Math.abs(n),d);return(n/g)+'/'+(d/g);}}return v.toFixed(2);}
      errMsg+='I'+subIdx(idx)+': F('+iv.b+') = '+fmtV(primEval(e.coeffs,iv.b))+' ; F('+iv.a+') = '+fmtV(primEval(e.coeffs,iv.a))+' → '+fmtV(iv.val)+'<br>';
    }
  });
  const allOk=(ok===tot);markBloque('bloque3',allOk);
  if(allOk)showFb('fb3',true,'✓ Todos los intervalos correctos');
  else showFb('fb3',false,'Valores correctos:<br>'+errMsg);
  if(ptsPasoT1.p3===null)ptsPasoT1.p3=allOk?PUNTOS_POR_APARTADO:0;
  actualizarUI();evaluarCompletitudT1();
}
