let ptsPasoT2={p1:null,p2:null,p3:null,p4:null};
let timerStart=null;

// ── Política del ejercicio: cada tipo tiene 4 apartados, cada uno vale 5/4 = 1,25 pts.
//    La puntuación de un apartado se fija en su PRIMER intento (correcto = 1,25, fallo = 0)
//    y ya no cambia después — así corregir con la solución que el feedback acaba de
//    revelar no da puntos, pero fallar un apartado solo cuesta ese apartado, no los 5
//    puntos del tipo entero. El resto de apartados del mismo tipo siguen abiertos.
const PUNTOS_MAX_TIPO=5;
const PUNTOS_POR_APARTADO=PUNTOS_MAX_TIPO/4; // 1.25

function puntosT1(){return Object.values(ptsPasoT1).reduce((a,b)=>a+(b||0),0);}
function puntosT2(){return Object.values(ptsPasoT2).reduce((a,b)=>a+(b||0),0);}


function startTimer(){if(!timerStart)timerStart=Date.now();}
function elapsed(){if(!timerStart)return'00:00';const s=Math.floor((Date.now()-timerStart)/1000);return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');}

// Aciertos/fallos: cada apartado se congela en su primer intento (correcto=1,25, fallo=0),
// así que basta con contar cuántos de los 8 apartados (4+4) han quedado en cada estado.
function recomputeAciertosFallos(){
  let ac=0,fa=0;
  ['p1','p2','p3','p4'].forEach(k=>{
    if(ptsPasoT1[k]===PUNTOS_POR_APARTADO)ac++; else if(ptsPasoT1[k]===0)fa++;
    if(ptsPasoT2[k]===PUNTOS_POR_APARTADO)ac++; else if(ptsPasoT2[k]===0)fa++;
  });
  state.aciertos=ac;
  state.fallos=fa;
}

function actualizarUI(){
  recomputeAciertosFallos();
  state.puntos=puntosT1()+puntosT2();
  document.getElementById('s-tipos').textContent=state.tiposCompletados.size+'/2';
  document.getElementById('s-ac').textContent=state.aciertos;
  document.getElementById('s-fail').textContent=state.fallos;
  const nota=Math.min(10,state.puntos);
  document.getElementById('s-pts').textContent=nota.toFixed(1)+'/10';
  document.getElementById('progreso-label').textContent='Tipos completados: '+state.tiposCompletados.size+'/2 · Puntuación: '+nota.toFixed(1)+'/10';
  document.getElementById('barra-fill').style.width=Math.min(100,(nota/10)*100)+'%';
  actualizarBadges();
}

function actualizarBadges(){
  TIPOS.forEach(t=>{
    const el=document.getElementById('badge-'+t);
    const ck=document.getElementById('check-'+t);
    if(!el)return;
    el.classList.remove('activo','completado');
    if(state.tiposCompletados.has(t)){
      el.classList.add('completado');
      if(ck) ck.textContent='✓ ';
    } else if(t===state.tipoActual){
      el.classList.add('activo');
      if(ck) ck.textContent='';
    } else {
      if(ck) ck.textContent='';
    }
  });
}

