<script>
// ═══════════════════════════════════════════════════════════════════
//  HELPERS POLINÓMICOS
// ═══════════════════════════════════════════════════════════════════
function sup(n){const m={'0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹'};return String(n).split('').map(c=>m[c]||c).join('');}
function subIdx(n){const m={'1':'₁','2':'₂','3':'₃','4':'₄'};return String(n).split('').map(c=>m[c]||c).join('');}
function polyEval(coeffs,x){return coeffs.reduce((a,c)=>a*x+c,0);}
function polyStr(coeffs){
  const deg=coeffs.length-1;let s='';
  coeffs.forEach((c,i)=>{const d=deg-i;if(c===0)return;const isFirst=s==='';const sign=c>0?(isFirst?'':' + '):(isFirst?'−':' − ');const abs=Math.abs(c);const absStr=abs===1&&d>0?'':String(abs);if(d===0)s+=sign+abs;else if(d===1)s+=sign+absStr+'x';else s+=sign+absStr+'x'+sup(d);});
  return s||'0';
}
function gcd(a,b){return b===0?a:gcd(b,a%b);}
function toFrac(val){for(let d=1;d<=12;d++){const n=Math.round(val*d);if(Math.abs(n/d-val)<1e-9){const g=gcd(Math.abs(n),d);return[n/g,d/g];}}return[Math.round(val*100)/100,1];}
function primCoeffs(coeffs){const deg=coeffs.length-1;return coeffs.map((c,i)=>c/(deg-i+1)).concat([0]);}
function primEval(coeffs,x){return primCoeffs(coeffs).reduce((a,c)=>a*x+c,0);}
function primStr(coeffs){
  const p=primCoeffs(coeffs);const deg=p.length-1;let s='';
  p.forEach((c,i)=>{const d=deg-i;if(d===0||c===0)return;const isFirst=s==='';const sign=c>0?(isFirst?'':' + '):(isFirst?'−':' − ');const absC=Math.abs(c);const[num,den]=toFrac(absC);let cs=den===1?(num===1&&d>0?'':String(num)):(num+'/'+den);if(d===1)s+=sign+cs+'x';else s+=sign+cs+'x'+sup(d);});
  return s||'0';
}

// ── Validación de primitiva por evaluación numérica ──
function normalizarExpresion(raw){
  let s=raw.trim();
  s=s.replace(/^[Ff]\s*\([xX]\)\s*=\s*/,'');
  s=s.replace(/[−–—]/g,'-');
  // Coma decimal española (0,5 -> 0.5), antes de cualquier otra sustitución
  s=s.replace(/(\d),(\d)/g,'$1.$2');
  // Punto medio · como multiplicación (usado en fracciones tipo "3/2·x²")
  s=s.replace(/\u00B7/g,'*').replace(/·/g,'*');
  s=s.replace(/x²/g,'x^2').replace(/x³/g,'x^3').replace(/x⁴/g,'x^4').replace(/x⁵/g,'x^5').replace(/x⁶/g,'x^6').replace(/x¹/g,'x^1');
  s=s.replace(/\^/g,'**');
  s=s.replace(/(\d+)\/(\d+)\s*(\*?)\s*x/g,'($1/$2)*x');
  s=s.replace(/(\d)(\*?)\s*x/g,'$1*x');
  s=s.replace(/^(-?)(\d+)\/(\d+)\s*(\*?)\s*x/g,'$1($2/$3)*x');
  s=s.replace(/(?<!\d)-x/g,'-1*x');
  s=s.replace(/^x/g,'1*x');
  s=s.replace(/\s/g,'');
  return s;
}
function evaluarExpresion(expr,xVal){try{const fn=new Function('x','return ('+expr+')');return fn(xVal);}catch(e){return NaN;}}
function checkPrimCorrecta(input,coeffs){
  if(!input||input.trim()==='')return false;
  const exprN=normalizarExpresion(input);
  const pts=[-3,-2,-1,0,1,2,3,-1.5,1.5,-2.5,2.5];
  let ok=0,tot=0;
  for(const x of pts){
    const v=evaluarExpresion(exprN,x);if(isNaN(v))continue;
    const vr=primEval(coeffs,x);tot++;
    const tol=Math.max(0.1,Math.abs(vr)*0.05);
    if(Math.abs(v-vr)<=tol)ok++;
  }
  if(tot===0)return false;
  return ok>=Math.min(8,tot-1);
}

// ── Normalización y evaluación en m ──
function normalizarExpresionM(raw){
  let s=raw.trim();
  s=s.replace(/[−–—]/g,'-');
  // Coma decimal española (0,5 -> 0.5), antes de cualquier otra sustitución
  s=s.replace(/(\d),(\d)/g,'$1.$2');
  // Punto medio · (U+00B7) como multiplicación: 3/2·m² → 3/2*m^2
  s=s.replace(/\u00B7/g,'*').replace(/·/g,'*');
  // Superíndices unicode
  s=s.replace(/m²/g,'m^2').replace(/m³/g,'m^3').replace(/m⁴/g,'m^4');
  // Potencias
  s=s.replace(/\^/g,'**');
  // Fracciones seguidas de m: 1/3*m o 1/3m → (1/3)*m
  s=s.replace(/(\d+)\/(\d+)\s*\*?\s*m/g,'($1/$2)*m');
  // Dígito pegado a m: 3m → 3*m
  s=s.replace(/(\d)\*?m/g,'$1*m');
  // -m sin dígito delante
  s=s.replace(/(?<![0-9\)])-m/g,'-1*m');
  // m al inicio de expresión
  s=s.replace(/^m/g,'1*m');
  s=s.replace(/\s/g,'');
  return s;
}
function evaluarEnM(expr,mVal){
  try{const fn=new Function('m','return ('+expr+')');return fn(mVal);}catch(e){return NaN;}
}

// ── Validación primitiva T2 por evaluación numérica ──
// fnPrim(x) es la función primitiva correcta
function checkPrimT2(input, fnPrim){
  if(!input||input.trim()==='')return false;
  const exprN=normalizarExpresion(input);
  const pts=[-3,-2,-1,0,1,2,3,1.5,2.5];
  let ok=0,tot=0;
  for(const x of pts){
    const v=evaluarExpresion(exprN,x);if(isNaN(v))continue;
    const vr=fnPrim(x);tot++;
    const tol=Math.max(0.05,Math.abs(vr)*0.05);
    if(Math.abs(v-vr)<=tol)ok++;
  }
  if(tot===0)return false;
  return ok>=Math.min(7,tot-1);
}

// ── Validación expresión Barrow en m ──
// fnBarrow(m) = F(m) - F(0) correcta
function checkBarrowT2(input, fnBarrow){
  if(!input||input.trim()==='')return false;
  const exprN=normalizarExpresionM(input);
  const pts=[1,2,3,4,5,1.5,3.5];
  let ok=0,tot=0;
  for(const mv of pts){
    const v=evaluarEnM(exprN,mv);if(isNaN(v))continue;
    const vr=fnBarrow(mv);tot++;
    const tol=Math.max(0.05,Math.abs(vr)*0.05);
    if(Math.abs(v-vr)<=tol)ok++;
  }
  if(tot===0)return false;
  return ok>=Math.min(6,tot-1);
}

// ═══════════════════════════════════════════════════════════════════
//  GENERADORES TIPO 1
// ═══════════════════════════════════════════════════════════════════
function randInt(min,max){return Math.floor(Math.random()*(max-min+1))+min;}
function genRecta(crec){const m=crec?randInt(1,4):randInt(-4,-1);const raiz=randInt(-3,3);const b=-m*raiz;const coeffs=[m,b];const d1=randInt(1,3),d2=randInt(1,3);const limA=raiz-d1,limB=raiz+d2;const i1=primEval(coeffs,raiz)-primEval(coeffs,limA);const i2=primEval(coeffs,limB)-primEval(coeffs,raiz);return{tipo:crec?'recta_crec':'recta_dec',tipoStr:crec?'Recta creciente':'Recta decreciente',coeffs,raices:[raiz],limA,limB,intervalos:[{a:limA,b:raiz,val:i1},{a:raiz,b:limB,val:i2}],atotal:Math.round((Math.abs(i1)+Math.abs(i2))*100)/100};}
function genParabola(conc){let r1,r2;do{r1=randInt(-4,-1);r2=randInt(1,4);}while(Math.abs(r1)===Math.abs(r2));const a=conc?1:-1;const coeffs=[a,-a*(r1+r2),a*r1*r2];const limA=r1,limB=r2;const val=primEval(coeffs,limB)-primEval(coeffs,limA);return{tipo:conc?'parabola_conc':'parabola_conv',tipoStr:conc?'Parábola cóncava (∪)':'Parábola convexa (∩)',coeffs,raices:[r1,r2],limA,limB,intervalos:[{a:limA,b:limB,val}],atotal:Math.round(Math.abs(val)*100)/100};}
function genCubica(crec){let r1,r2,r3;do{r1=randInt(-4,-1);r2=randInt(r1+1,1);r3=randInt(r2+1,4);}while(Math.abs(r1)===Math.abs(r3));const a=crec?1:-1;const s1=r1+r2+r3,s2=r1*r2+r1*r3+r2*r3,s3=r1*r2*r3;const coeffs=[a,-a*s1,a*s2,-a*s3];const i1=primEval(coeffs,r2)-primEval(coeffs,r1);const i2=primEval(coeffs,r3)-primEval(coeffs,r2);return{tipo:crec?'cubica_crec':'cubica_dec',tipoStr:crec?'Cúbica creciente':'Cúbica decreciente',coeffs,raices:[r1,r2,r3],limA:r1,limB:r3,intervalos:[{a:r1,b:r2,val:i1},{a:r2,b:r3,val:i2}],atotal:Math.round((Math.abs(i1)+Math.abs(i2))*100)/100};}
const generadores=[()=>genRecta(true),()=>genRecta(false),()=>genParabola(true),()=>genParabola(false),()=>genCubica(true),()=>genCubica(false)];

// ═══════════════════════════════════════════════════════════════════
//  GENERADOR TIPO 2 — banco de funciones
// ═══════════════════════════════════════════════════════════════════

const BANCO_T2 = [
  {
    fStr: '2x + 1',
    FStr: 'x² + x',
    primPlaceholder: 'Ej: 3x² + 5x',
    barrowPlaceholder: 'Ej: 3m² + 5m',
    fnPrim: x => x*x + x,
    fnBarrow: m => m*m + m,
    solveM: S => (-1 + Math.sqrt(1 + 4*S)) / 2,
    genS: () => { const m=randInt(2,9); return {S: m*m+m, mCorr: m}; }
  },
  {
    fStr: '3x + 2',
    FStr: '3/2·x² + 2x',
    primPlaceholder: 'Ej: x² + 4x',
    barrowPlaceholder: 'Ej: m² + 4m',
    fnPrim: x => 1.5*x*x + 2*x,
    fnBarrow: m => 1.5*m*m + 2*m,
    solveM: S => (-2 + Math.sqrt(4 + 6*S)) / 3,
    genS: () => { const m=randInt(2,7); return {S: 1.5*m*m+2*m, mCorr: m}; }
  },
  {
    fStr: 'x + 3',
    FStr: '1/2·x² + 3x',
    primPlaceholder: 'Ej: 2x² + x',
    barrowPlaceholder: 'Ej: 2m² + m',
    fnPrim: x => 0.5*x*x + 3*x,
    fnBarrow: m => 0.5*m*m + 3*m,
    solveM: S => (-3 + Math.sqrt(9 + 2*S)),
    genS: () => { const m=randInt(2,8); return {S: 0.5*m*m+3*m, mCorr: m}; }
  },
  {
    fStr: '4x + 2',
    FStr: '2x² + 2x',
    primPlaceholder: 'Ej: x² + 3x',
    barrowPlaceholder: 'Ej: m² + 3m',
    fnPrim: x => 2*x*x + 2*x,
    fnBarrow: m => 2*m*m + 2*m,
    solveM: S => (-2 + Math.sqrt(4 + 8*S)) / 4,
    genS: () => { const m=randInt(2,7); return {S: 2*m*m+2*m, mCorr: m}; }
  },
  {
    fStr: 'x² + 2x',
    FStr: '1/3·x³ + x²',
    primPlaceholder: 'Ej: 2x³ + x²',
    barrowPlaceholder: 'Ej: 2m³ + m²',
    fnPrim: x => x*x*x/3 + x*x,
    fnBarrow: m => m*m*m/3 + m*m,
    solveM: S => {
      let mv=3;
      for(let i=0;i<50;i++){const f=mv*mv*mv/3+mv*mv-S;const fp=mv*mv+2*mv;mv-=f/fp;}
      return Math.round(mv*100)/100;
    },
    genS: () => { const m=randInt(2,5); return {S: m*m*m/3+m*m, mCorr: m}; }
  },
  {
    fStr: '2x² + x',
    FStr: '2/3·x³ + 1/2·x²',
    primPlaceholder: 'Ej: x³ + 2x²',
    barrowPlaceholder: 'Ej: m³ + 2m²',
    fnPrim: x => 2*x*x*x/3 + 0.5*x*x,
    fnBarrow: m => 2*m*m*m/3 + 0.5*m*m,
    solveM: S => {
      let mv=2;
      for(let i=0;i<50;i++){const f=2*mv*mv*mv/3+0.5*mv*mv-S;const fp=2*mv*mv+mv;mv-=f/fp;}
      return Math.round(mv*100)/100;
    },
    genS: () => { const m=randInt(2,4); return {S: Math.round((2*m*m*m/3+0.5*m*m)*100)/100, mCorr: m}; }
  }
];

function genTipo2(){
  const plantilla = BANCO_T2[randInt(0, BANCO_T2.length-1)];
  const {S, mCorr} = plantilla.genS();
  return {
    plantilla,
    fStr: plantilla.fStr,
    FStr: plantilla.FStr,
    primPlaceholder: plantilla.primPlaceholder,
    barrowPlaceholder: plantilla.barrowPlaceholder,
    S: Math.round(S*100)/100,
    mCorrecto: mCorr
  };
}

// ═══════════════════════════════════════════════════════════════════
