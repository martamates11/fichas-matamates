function checkPaso1(){
  startTimer();const e=currentEjT1;let ok=0,tot=0;
  const tipoOk=document.getElementById('e_tipo').value===e.tipo;
  markField('e_tipo',tipoOk);ok+=tipoOk?1:0;tot++;
  const rIds=['e_r1','e_r2','e_r3'];
  const raicesCorrectas=[...e.raices];
  const camposUsados=new Set();
  raicesCorrectas.forEach(r=>{let found=false;rIds.forEach((id,i)=>{if(!found&&i<e.raices.length&&!camposUsados.has(id)){if(has(xn(document.getElementById(id).value),r)){camposUsados.add(id);found=true;}}});});
  const raicesRestantes=[...raicesCorrectas];
  rIds.forEach((id,i)=>{if(i>=e.raices.length){return;}const v=xn(document.getElementById(id).value);const idx=raicesRestantes.findIndex(r=>has(v,r));if(idx!==-1){markField(id,true);raicesRestantes.splice(idx,1);ok++;tot++;}else{markField(id,false);tot++;}});
  const allOk=(ok===tot);markBloque('bloque1',allOk);
  if(allOk){showFb('fb1',true,'✓ Correcto — '+e.tipoStr+', raíces: x = '+e.raices.join(', '));}
  else{let msg='';if(!tipoOk)msg+='Tipo: <em>'+e.tipoStr+'</em><br>';if(raicesRestantes.length)msg+='Raíces correctas: x = '+e.raices.join(', ')+'<br><span style="font-size:0.78rem">(el orden no importa)</span>';showFb('fb1',false,msg);}
  if(ptsPasoT1.p1===null)ptsPasoT1.p1=allOk?PUNTOS_POR_APARTADO:0;
  actualizarUI();evaluarCompletitudT1();
}
