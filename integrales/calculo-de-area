  } else {
    fb.className='fb show fail';
    fb.innerHTML='Tipo 2 terminado: <strong>'+aciertosN+' de 4 apartados correctos</strong> — <strong>'+puntos.toFixed(2)+'/5 puntos</strong>. Cada apartado fallado se ha quedado en 0 pts (ya se reveló su solución). Usa "Hacer otro ejercicio T2" para un intento nuevo y limpio.';
  }
  if(!state.tiposCompletados.has('tipo1')){
    document.getElementById('aviso-pendiente-t2').classList.add('show');
  }
}

// ═══════════════════════════════════════════════════════════════════
//  NUEVO EJERCICIO
// ═══════════════════════════════════════════════════════════════════
function generarNuevoEjT1(){
  state.tiposCompletados.delete('tipo1');
  currentEjT1=generadores[Math.floor(Math.random()*generadores.length)]();
  buildEjT1(currentEjT1);
  actualizarUI();
}
function generarNuevoEjT2(){
  state.tiposCompletados.delete('tipo2');
  currentEjT2=genTipo2();
  buildEjT2(currentEjT2);
  actualizarUI();
}

let tipoPendienteNuevo=null;
function mostrarConfirmNuevoEjercicio(tipo){
  tipoPendienteNuevo=tipo;
  const puntos=tipo==='tipo1'?puntosT1():puntosT2();
  document.getElementById('confirm-nuevo-texto').innerHTML=
    'Este '+(tipo==='tipo1'?'Tipo 1':'Tipo 2')+' ya tiene <strong>'+puntos.toFixed(2)+' puntos</strong> conseguidos.<br><br>'+
    'Si generas un ejercicio nuevo, esos puntos se pierden y empiezas este tipo desde 0.';
  document.getElementById('confirm-nuevo-bg').classList.add('show');
}
function cancelarNuevoEjercicio(){
  document.getElementById('confirm-nuevo-bg').classList.remove('show');
  tipoPendienteNuevo=null;
}
function confirmarNuevoEjercicio(){
  document.getElementById('confirm-nuevo-bg').classList.remove('show');
  if(tipoPendienteNuevo==='tipo1')generarNuevoEjT1();
  else if(tipoPendienteNuevo==='tipo2')generarNuevoEjT2();
  tipoPendienteNuevo=null;
}

function nuevoEjT1(){
  if(puntosT1()>0){mostrarConfirmNuevoEjercicio('tipo1');return;}
  generarNuevoEjT1();
}
function nuevoEjT2(){
  if(puntosT2()>0){mostrarConfirmNuevoEjercicio('tipo2');return;}
  generarNuevoEjT2();
}

// ═══════════════════════════════════════════════════════════════════
//  CALCULADORA
// ═══════════════════════════════════════════════════════════════════
let cexpr='';
function toggleCalc(){const b=document.getElementById('calc-body');b.classList.toggle('open');document.getElementById('calc-arrow').textContent=b.classList.contains('open')?'▾':'▸';}
function cc(v){const sc=document.getElementById('cscreen');if(v==='AC'){cexpr='';sc.textContent='0';return;}if(v==='+/-'){try{cexpr=String(parseFloat(eval(cexpr))*-1);sc.textContent=cexpr;}catch(e){}return;}if(v==='%'){try{cexpr=String(parseFloat(eval(cexpr))/100);sc.textContent=cexpr;}catch(e){}return;}if(v==='='){try{cexpr=String(Math.round(eval(cexpr)*1e10)/1e10);sc.textContent=cexpr;}catch(e){sc.textContent='Error';cexpr='';}return;}cexpr+=v;sc.textContent=cexpr;}

// ═══════════════════════════════════════════════════════════════════
//  FINALIZAR
// ═══════════════════════════════════════════════════════════════════
function finalizar(){
  const nombreEl=document.getElementById('nombre');
  if(!nombreEl.value.trim()){nombreEl.style.borderBottom='2px solid #8B1A1A';nombreEl.placeholder='⚠ Escribe tu nombre antes de finalizar';nombreEl.focus();return;}
  if(state.tiposCompletados.size<2){
    mostrarAvisoIncompleto();
    return;
  }
  finalizarDeVerdad();
}

function mostrarAvisoIncompleto(){
  const faltantes=[];
  if(!state.tiposCompletados.has('tipo1'))faltantes.push('Tipo 1');
  if(!state.tiposCompletados.has('tipo2'))faltantes.push('Tipo 2');
  const notaActual=Math.min(10,state.puntos);
  document.getElementById('aviso-texto').innerHTML=
    'Todavía te falta completar: <strong>'+faltantes.join(' y ')+'</strong>.<br><br>'+
    'Si finalizas ahora, tu nota quedará en <strong>'+notaActual.toFixed(2)+'/10</strong>.<br><br>'+
    '<span style="font-size:0.78rem">Si después cierras el resumen con "Cerrar y seguir practicando", este intento se reinicia por completo y perderías lo ya conseguido.</span>';
  document.getElementById('aviso-bg').classList.add('show');
}
function cerrarAvisoIncompleto(){
  document.getElementById('aviso-bg').classList.remove('show');
}
function confirmarFinalizarIncompleto(){
  document.getElementById('aviso-bg').classList.remove('show');
  finalizarDeVerdad();
}

function finalizarDeVerdad(){
  const nombreEl=document.getElementById('nombre');
  const nombre=nombreEl.value.trim();
  const nota=Math.min(10,state.puntos);
  const now=new Date();
  const fecha=String(now.getDate()).padStart(2,'0')+'/'+String(now.getMonth()+1).padStart(2,'0')+'/'+now.getFullYear();
  const hora=String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0')+':'+String(now.getSeconds()).padStart(2,'0');
  const cols={10:{bg:'#1a7a1a',txt:'#fff',v:true},9:{bg:'#6dbf6d',txt:'#fff'},8:{bg:'#1a4f8a',txt:'#fff'},7:{bg:'#5b9bd5',txt:'#fff'},6:{bg:'#c05c00',txt:'#fff'},5:{bg:'#f5a623',txt:'#000'}};
  const k=nota>=10?10:nota>=9?9:nota>=8?8:nota>=7?7:nota>=6?6:nota>=5?5:-1;
  const col=cols[k]||{bg:'#8B1A1A',txt:'#fff'};
  const modal=document.getElementById('modal');modal.style.background=col.bg;modal.style.color=col.txt;modal.querySelector('.btn-cerrar').style.color=col.txt;
  document.getElementById('m-nombre').textContent=nombre;
  document.getElementById('m-nota').textContent=nota.toFixed(1)+' / 10';
  const tiposStr=Array.from(state.tiposCompletados).map(t=>t==='tipo1'?'Tipo 1 ✓':'Tipo 2 ✓').join(' · ')||'Ninguno completado';
  document.getElementById('m-meta').innerHTML='Fecha: '+fecha+'<br>Hora: '+hora+'<br>Tiempo: '+elapsed()+'<br>Tipos completados: '+tiposStr+'<br>Aciertos: '+state.aciertos+' · Fallos: '+state.fallos;
  document.getElementById('modal-bg').classList.add('show');
  if(col.v)document.getElementById('wrap').classList.add('verde-total');
}

function cerrarModal(){
  document.getElementById('modal-bg').classList.remove('show');
  document.getElementById('wrap').classList.remove('verde-total');
  state={puntos:0,tiposCompletados:new Set(),tipoActual:'tipo1',aciertos:0,fallos:0,inicio:null};
  timerStart=null;
  document.getElementById('nombre').value='';
  document.getElementById('nombre').style.borderBottom='';
  document.getElementById('nombre').placeholder='Escribe tu nombre completo...';
  actualizarUI();
  nuevoEjT1();nuevoEjT2();
  elegirTipo('tipo1');
}

// ═══════════════════════════════════════════════════════════════════
//  ACCESIBILIDAD: tecla Enter dispara el botón "Comprobar" del bloque
//  actual (funciona también con los inputs generados dinámicamente,
//  como los de los intervalos, por delegación de eventos).
// ═══════════════════════════════════════════════════════════════════
document.addEventListener('keydown', function(e){
  if(e.key!=='Enter')return;
  const t=e.target;
  if(t.tagName!=='INPUT'&&t.tagName!=='SELECT')return;
  const bloque=t.closest('.paso-bloque');
  if(!bloque)return;
  const btn=bloque.querySelector('.btn-paso');
  if(btn){e.preventDefault();btn.click();}
});

// ═══════════════════════════════════════════════════════════════════
//  INICIO
// ═══════════════════════════════════════════════════════════════════
nuevoEjT1();
nuevoEjT2();
elegirTipo('tipo1');
actualizarUI();
</script>
