<script>
const N = 3;
const MAX_PTS = 60;
const startTime = Date.now();
const TEST_POINTS = [2, 5, -3]; // suficientes para identificar de forma única un polinomio de grado ≤ 2
const TOL = 1e-6;

let score = 0, aciertos = 0, fallos = 0;
let currentA = [], currentB = [];
let operationResults = {};

let masteredEver = { sum:false, diff:false, twoA:false, product:false, productBA:false, productATBT:false };
let attemptedThisInstance = { sum:false, diff:false, twoA:false, product:false, productBA:false, productATBT:false };

function randomInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
function stripHtml(str) { return str.replace(/<[^>]*>/g, ''); }

// ---------- Polinomios en x: array donde el índice i = coeficiente de x^i ----------
function trimPoly(p) {
  const r = p.slice();
  while (r.length > 1 && Math.abs(r[r.length - 1]) < 1e-9) r.pop();
  if (r.length === 0) r.push(0);
  return r;
}
function polyAdd(p, q) {
  const len = Math.max(p.length, q.length), r = [];
  for (let i = 0; i < len; i++) r.push((p[i] || 0) + (q[i] || 0));
  return trimPoly(r);
}
function polySub(p, q) {
  const len = Math.max(p.length, q.length), r = [];
  for (let i = 0; i < len; i++) r.push((p[i] || 0) - (q[i] || 0));
  return trimPoly(r);
}
function polyScale(k, p) { return trimPoly(p.map(c => c * k)); }
function polyMul(p, q) {
  const r = new Array(p.length + q.length - 1).fill(0);
  for (let i = 0; i < p.length; i++) for (let j = 0; j < q.length; j++) r[i + j] += p[i] * q[j];
  return trimPoly(r);
}
function polyEval(p, xVal) {
  let s = 0;
  for (let i = p.length - 1; i >= 0; i--) s = s * xVal + p[i];
  return s;
}
function formatNum(n) { return Number.isInteger(n) ? String(n) : n.toFixed(2).replace(/\.?0+$/, ''); }
function superscript(n) { return ({2:'²',3:'³',4:'⁴'})[n] || ('^' + n); }
function polyToDisplayString(p) {
  const terms = [];
  for (let i = p.length - 1; i >= 0; i--) {
    const c = p[i];
    if (Math.abs(c) < 1e-9) continue;
    const absC = Math.abs(c);
    let txt;
    if (i === 0) txt = formatNum(absC);
    else if (i === 1) txt = (absC === 1 ? '' : formatNum(absC)) + 'x';
    else txt = (absC === 1 ? '' : formatNum(absC)) + 'x' + superscript(i);
    terms.push({ neg: c < 0, txt });
  }
  if (terms.length === 0) return '0';
  let out = (terms[0].neg ? '−' : '') + terms[0].txt;
  for (let k = 1; k < terms.length; k++) out += (terms[k].neg ? ' − ' : ' + ') + terms[k].txt;
  return out;
}

// ---------- Parser/evaluador de expresiones del alumno ----------
function normalizeExprString(str) {
  return str.replace(/,/g, '.').replace(/·/g, '*').replace(/²/g, '^2').replace(/³/g, '^3').replace(/X/g, 'x').trim();
}
function tokenize(str) {
  const s = normalizeExprString(str);
  const tokens = [];
  let i = 0;
  while (i < s.length) {
    const ch = s[i];
    if (ch === ' ' || ch === '\t') { i++; continue; }
    if (/[0-9.]/.test(ch)) {
      let j = i;
      while (j < s.length && /[0-9.]/.test(s[j])) j++;
      const numStr = s.slice(i, j);
      if ((numStr.match(/\./g) || []).length > 1) throw new Error('número mal escrito');
      tokens.push({ type: 'num', value: parseFloat(numStr) });
      i = j; continue;
    }
    if (ch === 'x') { tokens.push({ type: 'x' }); i++; continue; }
    if ('+-*/^()'.includes(ch)) { tokens.push({ type: ch }); i++; continue; }
    throw new Error('carácter no reconocido: ' + ch);
  }
  return tokens;
}
function evalExprAt(str, xVal) {
  const tokens = tokenize(str);
  let pos = 0;
  const peek = () => tokens[pos];
  const next = () => tokens[pos++];
  const canStartFactor = (t) => t && (t.type === 'num' || t.type === 'x' || t.type === '(');
  function parseExpression() {
    let v = parseTerm();
    while (peek() && (peek().type === '+' || peek().type === '-')) {
      const op = next().type;
      const rhs = parseTerm();
      v = op === '+' ? v + rhs : v - rhs;
    }
    return v;
  }
  function parseTerm() {
    let v = parseFactor();
    while (peek() && (peek().type === '*' || peek().type === '/' || canStartFactor(peek()))) {
      if (peek().type === '*') { next(); v *= parseFactor(); }
      else if (peek().type === '/') { next(); v /= parseFactor(); }
      else { v *= parseFactor(); }
    }
    return v;
  }
  function parseFactor() {
    if (peek() && peek().type === '+') { next(); return parseFactor(); }
    if (peek() && peek().type === '-') { next(); return -parseFactor(); }
    let base = parsePrimary();
    if (peek() && peek().type === '^') { next(); const exp = parseFactor(); base = Math.pow(base, exp); }
    return base;
  }
  function parsePrimary() {
    const t = peek();
    if (!t) throw new Error('expresión incompleta');
    if (t.type === 'num') { next(); return t.value; }
    if (t.type === 'x') { next(); return xVal; }
    if (t.type === '(') {
      next();
      const v = parseExpression();
      if (!peek() || peek().type !== ')') throw new Error('falta un paréntesis de cierre');
      next();
      return v;
    }
    throw new Error('token inesperado');
  }
  if (tokens.length === 0) throw new Error('vacío');
  const result = parseExpression();
  if (pos !== tokens.length) throw new Error('expresión mal formada');
  if (!isFinite(result)) throw new Error('resultado no numérico');
  return result;
}
function cellMatches(userStr, correctPoly) {
  for (const xv of TEST_POINTS) {
    const uv = evalExprAt(userStr, xv);
    const cv = polyEval(correctPoly, xv);
    if (Math.abs(uv - cv) > TOL) return false;
  }
  return true;
}

// ---------- Matrices (celdas = polinomios) ----------
function generateMatrixWithX() {
  const M = [];
  const xi = randomInt(0, N - 1), xj = randomInt(0, N - 1);
  for (let i = 0; i < N; i++) {
    const row = [];
    for (let j = 0; j < N; j++) row.push(i === xi && j === xj ? [0, 1] : [randomInt(-3, 3)]);
    M.push(row);
  }
  return M;
}
const I3P = [[[1],[0],[0]],[[0],[1],[0]],[[0],[0],[1]]];
function addMatricesP(A, B) { const R=[]; for(let i=0;i<N;i++){const row=[];for(let j=0;j<N;j++)row.push(polyAdd(A[i][j],B[i][j]));R.push(row);} return R; }
function subMatricesP(A, B) { const R=[]; for(let i=0;i<N;i++){const row=[];for(let j=0;j<N;j++)row.push(polySub(A[i][j],B[i][j]));R.push(row);} return R; }
function scalarMulP(k, M) { const R=[]; for(let i=0;i<N;i++){const row=[];for(let j=0;j<N;j++)row.push(polyScale(k,M[i][j]));R.push(row);} return R; }
function mulMatricesP(A, B) {
  const R = [];
  for (let i=0;i<N;i++){ const row=[]; for(let j=0;j<N;j++){ let s=[0]; for(let k=0;k<N;k++) s=polyAdd(s, polyMul(A[i][k], B[k][j])); row.push(s); } R.push(row); }
  return R;
}
function transposeP(M) { const R=[]; for(let i=0;i<N;i++){const row=[];for(let j=0;j<N;j++)row.push(M[j][i]);R.push(row);} return R; }
function twoAMinus3I_P(A) { return subMatricesP(scalarMulP(2, A), scalarMulP(3, I3P)); }

const OPERATIONS = [
  { id: 'sum', name: 'A + B', pts: 10,
    motivo: 'En la suma de matrices se suma cada elemento con el que ocupa la misma posición: (A+B)ᵢⱼ = Aᵢⱼ + Bᵢⱼ. Como A y B son como mucho de primer grado en x, el resultado nunca lleva x².' },
  { id: 'diff', name: 'A − B', pts: 10,
    motivo: 'En la resta de matrices se resta cada elemento con el que ocupa la misma posición: (A−B)ᵢⱼ = Aᵢⱼ − Bᵢⱼ. El resultado, igual que en la suma, no lleva x².' },
  { id: 'twoA', name: '2A − 3I', pts: 10,
    motivo: 'Primero se multiplica cada elemento de A por 2 (si esa casilla es x, queda 2x). Después se resta 3 solo en la diagonal principal, ya que 3I únicamente tiene valores ahí. No aparece x².' },
  { id: 'product', name: 'A × B', pts: 10,
    motivo: 'En el producto de matrices cada elemento se calcula multiplicando la fila correspondiente de A por la columna correspondiente de B y sumando los productos (no se multiplica posición a posición). Comprueba si en alguna casilla se multiplica la x de A por la x de B: si es así, aparecerá un término en x², además del término en x y del término independiente.' },
  { id: 'productBA', name: 'B × A', pts: 10,
    motivo: 'El producto de matrices no es conmutativo: B×A no tiene por qué coincidir con A×B. Multiplica cada fila de B por cada columna de A y, de nuevo, vigila si se cruzan las dos casillas con x: si es así aparece un término en x².' },
  { id: 'productATBT', name: 'A<sup>T</sup> × B<sup>T</sup>', pts: 10,
    motivo: 'Primero se transponen A y B (se intercambian filas por columnas; la x se mueve de posición con el resto de la matriz) y después se multiplican esas matrices transpuestas siguiendo la regla fila por columna. Puede volver a aparecer x² si coinciden las casillas con x.' }
];

function updateScoresUI() {
  document.getElementById('score-pts').textContent = (Math.round(score*10)/10);
  document.getElementById('score-ok').textContent = aciertos;
  document.getElementById('score-fail').textContent = fallos;
}
function updateProgressDots() {
  const container = document.getElementById('progress-steps');
  if(!container) return;
  let html = '';
  OPERATIONS.forEach((op, idx) => { html += `<div class="step-dot ${masteredEver[op.id] ? 'done' : ''}" title="${stripHtml(op.name)}">${idx+1}</div>`; });
  container.innerHTML = html;
}
function cellFeedbackList(matchGrid) {
  let wrongCells = [];
  for(let i=0;i<N;i++) for(let j=0;j<N;j++) if(!matchGrid[i][j]) wrongCells.push(`(fila ${i+1}, columna ${j+1})`);
  if (wrongCells.length === N*N) return 'Todos los elementos son incorrectos.';
  return `Revisa el/los elemento(s) en la posición ${wrongCells.join(', ')}.`;
}
function matrixToPre(correctMat) {
  const strs = correctMat.map(row => row.map(c => polyToDisplayString(c)));
  let maxLen = 4;
  strs.forEach(row => row.forEach(s => { if (s.length > maxLen) maxLen = s.length; }));
  const lines = [];
  for (let i=0;i<N;i++) lines.push(strs[i].map(s => s.padStart(maxLen)).join('  '));
  const openSyms = ['⎛','⎜','⎝'], closeSyms = ['⎞','⎟','⎠'];
  let html = '';
  for (let i=0;i<N;i++) html += `${openSyms[i]} ${lines[i]} ${closeSyms[i]}<br>`;
  return html;
}

function renderMatrixParentesis(M, label) {
  let rowsHtml = '';
  for(let i=0;i<N;i++){
    let cells = '';
    for(let j=0;j<N;j++){
      const str = polyToDisplayString(M[i][j]);
      const isX = M[i][j].length > 1;
      cells += `<div class="matrix-cell${isX ? ' is-x' : ''}">${str}</div>`;
    }
    rowsHtml += `<div class="matrix-row">${cells}</div>`;
  }
  return `
    <div class="matrix-card">
      <div class="matrix-letter">${label}</div>
      <div class="matrix">
        <span class="matrix-paren">(</span>
        <div class="matrix-content">${rowsHtml}</div>
        <span class="matrix-paren">)</span>
      </div>
    </div>
  `;
}

function renderInputs(opId, disabled) {
  const dis = disabled ? 'disabled' : '';
  let rowsHtml = '';
  for(let i=0;i<N;i++){
    let cells = '';
    for(let j=0;j<N;j++){
      const pos = `${i}${j}`;
      cells += `
        <label class="sr-only" for="${opId}_${pos}">Elemento fila ${i+1} columna ${j+1} de ${opId}</label>
        <input type="text" class="input-cell" id="${opId}_${pos}" placeholder="expr." maxlength="20" ${dis}>`;
    }
    rowsHtml += `<div class="input-row">${cells}</div>`;
  }
  return `<div class="input-matrix">${rowsHtml}</div>`;
}

function markCorrect(opId, earnedPts) {
  if(masteredEver[opId]) return;
  masteredEver[opId] = true;
  attemptedThisInstance[opId] = true;
  score += earnedPts;
  aciertos++;
  updateScoresUI();
  updateProgressDots();
  const fbDiv = document.getElementById(`fb-${opId}`);
  const statusSpan = document.getElementById(`status-${opId}`);
  if(statusSpan) { statusSpan.innerHTML = '✓ superado'; statusSpan.className = 'status-badge done'; }
  if(fbDiv) { fbDiv.className = 'feedback ok'; fbDiv.innerHTML = `✅ <strong>Correcto</strong> +${earnedPts} pts. Este tipo de operación queda superado para el resto de la sesión.`; }
  lockCard(opId);
  setTimeout(() => renderFullFicha(), 900);
}

function markWrong(opId, correctMat, matchGrid) {
  if(masteredEver[opId] || attemptedThisInstance[opId]) return;
  attemptedThisInstance[opId] = true;
  fallos++;
  // Este tipo de apartado revela el resultado exacto en el feedback de fallo,
  // así que queda cerrado en 0 puntos para este intento (ver lockCard). No se aplica
  // ninguna deducción sobre el score global: los puntos ya ganados en OTROS tipos
  // no deben verse afectados por un fallo en este.
  updateScoresUI();
  const fbDiv = document.getElementById(`fb-${opId}`);
  const statusSpan = document.getElementById(`status-${opId}`);
  const opDef = OPERATIONS.find(o=>o.id===opId);
  if(statusSpan) { statusSpan.innerHTML = '✗ bloqueada'; statusSpan.className = 'status-badge blocked'; }
  if(fbDiv) {
    fbDiv.className = 'feedback err';
    fbDiv.innerHTML = `❌ <strong>Incorrecto — este apartado queda en 0 pts para este intento</strong>
      <span class="celdas">${cellFeedbackList(matchGrid)}</span>
      <span class="motivo">💡 ${opDef.motivo}</span>
      <span class="solucion">🔍 Solución correcta:</span>
      <pre>${matrixToPre(correctMat)}</pre>
      <div style="margin-top:8px;font-size:.8rem">Pulsa "🔄 Nueva ficha" para obtener otra instancia de este tipo de operación.</div>`;
  }
  lockCard(opId);
}

function lockCard(opId) {
  for(let i=0;i<N;i++) for(let j=0;j<N;j++){ const el=document.getElementById(`${opId}_${i}${j}`); if(el) el.disabled = true; }
  const btn = document.getElementById(`chk-${opId}`);
  if(btn) btn.disabled = true;
}

function checkOperation(opId) {
  if (masteredEver[opId]) return;
  if (attemptedThisInstance[opId]) return;
  const fb = document.getElementById(`fb-${opId}`);

  const raw = [];
  let anyEmpty = false;
  for (let i=0;i<N;i++){ const row=[]; for(let j=0;j<N;j++){ const el=document.getElementById(`${opId}_${i}${j}`); const v=(el.value||'').trim(); if(v==='') anyEmpty=true; row.push(v); } raw.push(row); }
  if (anyEmpty) {
    if (fb) { fb.className='feedback err'; fb.innerHTML = `⚠️ Completa las ${N*N} casillas con una expresión (un número o una expresión con x).`; }
    return;
  }

  const correctMat = operationResults[opId];
  const matchGrid = [];
  const syntaxErrorCells = [];
  for (let i=0;i<N;i++){
    const row = [];
    for (let j=0;j<N;j++){
      try { row.push(cellMatches(raw[i][j], correctMat[i][j])); }
      catch(e) { syntaxErrorCells.push(`(fila ${i+1}, columna ${j+1})`); row.push(false); }
    }
    matchGrid.push(row);
  }

  if (syntaxErrorCells.length > 0) {
    if (fb) { fb.className='feedback err'; fb.innerHTML = `✏️ Hay un error de escritura en: ${syntaxErrorCells.join(', ')}. Usa solo x, +, −, *, ^2 (o ²) y paréntesis, y vuelve a corregir.`; }
    return; // no cuenta como intento
  }

  const allOk = matchGrid.every(row => row.every(v => v));
  if (allOk) markCorrect(opId, OPERATIONS.find(o=>o.id===opId).pts);
  else markWrong(opId, correctMat, matchGrid);
}

function checkAll() {
  OPERATIONS.forEach(op => { if(!masteredEver[op.id] && !attemptedThisInstance[op.id]) checkOperation(op.id); });
  const allMastered = OPERATIONS.every(op => masteredEver[op.id]);
  const globalDiv = document.getElementById('global-feedback');
  if(allMastered) {
    globalDiv.className = 'feedback ok';
    globalDiv.innerHTML = '🎉 ¡Has superado los 6 tipos de operación! Pulsa "Finalizar y Calificar" para registrar tu nota.';
  } else {
    globalDiv.className = 'feedback err';
    globalDiv.innerHTML = '📌 Aún quedan tipos de operación por superar.';
  }
}

function newExercise() {
  currentA = generateMatrixWithX();
  currentB = generateMatrixWithX();
  const At = transposeP(currentA);
  const Bt = transposeP(currentB);
  operationResults = {
    sum: addMatricesP(currentA, currentB),
    diff: subMatricesP(currentA, currentB),
    twoA: twoAMinus3I_P(currentA),
    product: mulMatricesP(currentA, currentB),
    productBA: mulMatricesP(currentB, currentA),
    productATBT: mulMatricesP(At, Bt)
  };
  OPERATIONS.forEach(op => { attemptedThisInstance[op.id] = false; });
  renderFullFicha();
  const gf = document.getElementById('global-feedback');
  if (gf) { gf.className = 'feedback'; gf.innerHTML = ''; }
}

function renderFullFicha() {
  const matricesHtml = renderMatrixParentesis(currentA, 'Matriz A =') + renderMatrixParentesis(currentB, 'Matriz B =');
  const instructionsHtml = `
    <div class="instructions-box">
      ✏️ <strong>Cómo escribir tus respuestas:</strong> usa <code>x</code> para la incógnita, <code>^2</code> o el símbolo <code>²</code> para el cuadrado, y escribe el número pegado a la x para multiplicar (<code>2x</code> equivale a 2·x). Ejemplos válidos: <code>3x-5</code>, <code>-2x^2+x-1</code>, <code>(x-2)*3</code>.
    </div>`;
  let opsHtml = `<div class="operations-grid">`;
  OPERATIONS.forEach(op => {
    const isMastered = masteredEver[op.id];
    const cardClass = isMastered ? 'op-card mastered' : 'op-card';
    const statusClass = isMastered ? 'status-badge done' : 'status-badge';
    const statusText = isMastered ? '✓ superado' : '◌ pendiente';
    if(isMastered) {
      opsHtml += `
        <div class="${cardClass}">
          <div class="op-title"><span class="op-name">${op.name}</span><span class="${statusClass}" id="status-${op.id}">${statusText}</span></div>
          <p style="font-size:.85rem;color:var(--color-texto-suave)">Ya superaste este tipo de operación. No hace falta repetirlo.</p>
        </div>`;
    } else {
      opsHtml += `
        <div class="${cardClass}">
          <div class="op-title"><span class="op-name">${op.name}</span><span class="${statusClass}" id="status-${op.id}">${statusText}</span></div>
          ${renderInputs(op.id, false)}
          <button class="btn-check-individual" id="chk-${op.id}" onclick="checkOperation('${op.id}')">Corregir</button>
          <div class="feedback" id="fb-${op.id}" aria-live="polite"></div>
        </div>`;
    }
  });
  opsHtml += `</div><div class="feedback" id="global-feedback" aria-live="polite"></div>`;
  document.getElementById('ex').innerHTML = `
    <div class="card">
      <h2>📐 Ejercicio <span id="exercise-counter">${OPERATIONS.filter(o=>masteredEver[o.id]).length}</span>/6
        <span class="card-tag">matrices 3×3 con la incógnita x</span>
      </h2>
      ${instructionsHtml}
      <div class="matrix-section">${matricesHtml}</div>
      ${opsHtml}
    </div>
  `;
  updateProgressDots();
  OPERATIONS.forEach(op => {
    if(masteredEver[op.id]) return;
    for(let i=0;i<N;i++){
      for(let j=0;j<N;j++){
        const el = document.getElementById(`${op.id}_${i}${j}`);
        if(el) { el.addEventListener('keydown', (e) => { if(e.key === 'Enter') { e.preventDefault(); checkOperation(op.id); } }); }
      }
    }
  });
}

function formatElapsed(ms) {
  const totalMinutesCeil = Math.ceil(ms / 60000);
  const h = Math.floor(totalMinutesCeil / 60);
  const m = totalMinutesCeil % 60;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
}

function showConfirmModal({icon = '⚠️', title, message, buttons}) {
  document.getElementById('confirm-icon').textContent = icon;
  document.getElementById('confirm-title').textContent = title;
  document.getElementById('confirm-message').innerHTML = message;
  const container = document.getElementById('confirm-buttons');
  container.innerHTML = '';
  buttons.forEach(b => {
    const btn = document.createElement('button');
    btn.className = 'btn ' + (b.primary ? 'btn-primary' : 'btn-secondary');
    btn.textContent = b.label;
    btn.onclick = () => { document.getElementById('confirm-overlay').style.display = 'none'; if (b.onClick) b.onClick(); };
    container.appendChild(btn);
  });
  document.getElementById('confirm-overlay').style.display = 'flex';
}

function finishAndGrade() {
  const studentName = document.getElementById('name-field').value.trim();
  if(!studentName) {
    showConfirmModal({
      icon: '✏️', title: 'Falta tu nombre',
      message: 'Escribe tu nombre y apellidos en la barra superior antes de finalizar y calificar.',
      buttons: [{ label: 'Entendido', primary: true, onClick: () => document.getElementById('name-field').focus() }]
    });
    return;
  }
  const resolvedCount = OPERATIONS.filter(o => masteredEver[o.id]).length;
  if (resolvedCount < OPERATIONS.length) {
    const missing = OPERATIONS.filter(o => !masteredEver[o.id]).map(o => o.name).join(', ');
    const provisionalNota = Math.min(10, Math.max(0, (score / MAX_PTS) * 10)).toFixed(1);
    showConfirmModal({
      icon: '📌', title: 'Todavía quedan tipos sin superar',
      message: `Te faltan por superar: <strong>${missing}</strong> (${resolvedCount}/${OPERATIONS.length} completados).<br><br>Si finalizas ahora, tu nota sería <strong>${provisionalNota} / 10</strong>.`,
      buttons: [
        { label: 'Seguir practicando', primary: false },
        { label: 'Finalizar igualmente', primary: true, onClick: () => actuallyFinish() }
      ]
    });
    return;
  }
  actuallyFinish();
}

function actuallyFinish() {
  const studentName = document.getElementById('name-field').value.trim();
  const resolvedCount = OPERATIONS.filter(o => masteredEver[o.id]).length;
  const finalScore = score;
  const maxPossible = MAX_PTS;
  let nota = (finalScore / maxPossible) * 10;
  nota = Math.min(10, Math.max(0, nota)).toFixed(1);
  const notaNum = parseFloat(nota);

  const now = new Date();
  const fecha = now.toLocaleDateString('es-ES');
  const hora = now.toLocaleTimeString('es-ES');
  const tiempo = formatElapsed(Date.now() - startTime);

  let bgColor, textColor;
  if (notaNum === 10) { bgColor = '#1a7a1a'; textColor = 'white'; }
  else if (notaNum >= 9) { bgColor = '#6dbf6d'; textColor = 'white'; }
  else if (notaNum >= 8) { bgColor = '#1a4f8a'; textColor = 'white'; }
  else if (notaNum >= 7) { bgColor = '#5b9bd5'; textColor = 'white'; }
  else if (notaNum >= 6) { bgColor = '#c05c00'; textColor = 'white'; }
  else if (notaNum >= 5) { bgColor = '#f5a623'; textColor = 'black'; }
  else { bgColor = '#c0392b'; textColor = 'white'; }

  const modalBox = document.getElementById('modal-box');
  modalBox.style.backgroundColor = bgColor;
  modalBox.style.color = textColor;
  document.getElementById('modal-close').style.color = textColor;
  document.getElementById('modal-btn').style.backgroundColor = 'rgba(255,255,255,0.2)';
  document.getElementById('modal-btn').style.color = textColor;
  document.getElementById('modal-btn').style.border = `1.5px solid ${textColor}`;

  document.getElementById('modal-title').innerHTML = `🎓 ${escapeHtml(studentName)}`;
  document.getElementById('modal-nota').innerHTML = `${nota} / 10`;
  document.getElementById('modal-data').innerHTML = `
    <div><strong>📋 Ficha:</strong> Operaciones con Matrices 3×3 y la incógnita x</div>
    <div><strong>📅 Fecha:</strong> ${fecha}</div>
    <div><strong>⏰ Hora:</strong> ${hora}</div>
    <div><strong>⏱️ Tiempo transcurrido:</strong> ${tiempo}</div>
    <div><strong>✅ Aciertos:</strong> ${aciertos} &nbsp;|&nbsp; <strong>❌ Fallos:</strong> ${fallos}</div>
    <div><strong>🎯 Puntuación:</strong> ${Math.round(finalScore*10)/10} / ${maxPossible}</div>
    <div><strong>📊 Tipos de operación superados:</strong> ${resolvedCount} / 6</div>
  `;
  document.getElementById('modal-overlay').style.display = 'flex';
}

function closeModal() { document.getElementById('modal-overlay').style.display = 'none'; }
function escapeHtml(str) { return str.replace(/[&<>]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;'})[m]); }

document.getElementById('btn-check').onclick = () => checkAll();
document.getElementById('btn-new').onclick = () => newExercise();
document.getElementById('btn-finish').onclick = () => finishAndGrade();

newExercise();
</script>
