  modal.style.color = fg;
  modal.innerHTML =
    '<div class="modal-titulo">' + document.querySelector('.titulo-ficha').textContent + '</div>' +
    '<div class="modal-sub">' + document.querySelector('.subtitulo').textContent + '</div>' +
    '<h2>Informe de la actividad</h2>' +
    '<div style="font-family:Lato,sans-serif;font-size:.95rem;">' + escapeHTML(inpNombre.value.trim()) + '</div>' +
    '<div class="modal-nota">' + state.nota + '</div>' +
    '<div style="font-size:.9rem;">sobre 10</div>' +
    '<div class="modal-datos">Fecha: ' + dos(ahora.getDate()) + '/' + dos(ahora.getMonth() + 1) + '/' + ahora.getFullYear() +
    ' · Hora: ' + dos(ahora.getHours()) + ':' + dos(ahora.getMinutes()) + ':' + dos(ahora.getSeconds()) +
    '<br>Tiempo empleado: ' + dos(Math.floor(minutos / 60)) + ':' + dos(minutos % 60) + ' (hh:mm)</div>' +
    '<table class="tabla-informe"><thead><tr><th>Ejercicio</th><th>Estado</th><th>Resultado</th><th>Pasos bien</th><th>Puntos</th></tr></thead><tbody>' + filas + '</tbody></table>' +
    '<button type="button" class="btn-cerrar" id="btn-cerrar">Cerrar</button>';
  document.getElementById('overlay').classList.add('visible');
  document.getElementById('btn-cerrar').addEventListener('click', cerrarModal);
  document.body.classList.toggle('nota-diez', state.nota >= 10);
});
function cerrarModal() { document.getElementById('overlay').classList.remove('visible'); }
document.getElementById('overlay').addEventListener('click', e => { if (e.target.id === 'overlay') cerrarModal(); });
function escapeHTML(s) { return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

render();
</script>
</body>
</html>
