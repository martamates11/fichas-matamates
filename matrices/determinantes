<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cálculo de determinantes</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Lato:wght@400;700&display=swap');

:root {
  --color-fondo: #F5F0E8;
  --color-fondo-card: #FDFAF3;
  --color-texto: #2C1F0E;
  --color-texto-suave: #6B4F35;
  --color-acento: #A0522D;
  --color-acento-hover: #7B3B1E;
  --color-borde: #C9A96E;
  --color-borde-suave: #E0CEAA;
  --color-cabecera: #3B2510;
  --color-cabecera-txt: #F5EDD8;
  --color-correcto: #2E6B3E;
  --color-incorrecto: #8B1A1A;
  --color-neutro: #E8DFC8;
  --color-aviso: #B7791F;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: 'Lato', sans-serif;
  font-size: 16px;
  color: var(--color-texto);
  background-color: var(--color-fondo);
  line-height: 1.5;
  transition: background-color .4s;
}
body.nota-diez { background-color: #cfe8cf; }
body.nota-diez .ficha-container { background: #eef7ee; border-color: #1a7a1a; }

h1, h2, h3, .titulo-ficha { font-family: 'Libre Baskerville', serif; color: var(--color-texto); }

/* ---------- Cabecera institucional ---------- */
.cabecera {
  background-color: var(--color-cabecera);
  color: var(--color-cabecera-txt);
  font-family: 'Libre Baskerville', serif;
  text-align: center;
  padding: 10px 20px;
  font-size: 0.78rem;
  letter-spacing: 0.04em;
}

/* ---------- Barra sticky: nombre + marcador (clara, bajo la cabecera) ---------- */
.cabecera { border-bottom: 3px solid var(--color-borde); }
.barra {
  position: sticky; top: 0; z-index: 50;
  background: #EFE4CC;
  border: 1.5px solid var(--color-borde);
  border-radius: 6px;
  margin: 0 0 22px;
  box-shadow: 0 2px 6px rgba(44, 31, 14, 0.08);
  color: var(--color-texto);
  padding: 9px 20px;
  display: flex; flex-wrap: wrap; gap: 10px 26px;
  align-items: center; justify-content: center;
  font-size: .92rem;
}
.barra label { font-family: 'Libre Baskerville', serif; font-size: .85rem; color: var(--color-texto-suave); }
.barra input#nombre {
  background: var(--color-fondo-card); border: 1.5px solid var(--color-borde); border-radius: 4px;
  padding: 6px 10px; font-family: 'Lato', sans-serif; font-size: .95rem;
  color: var(--color-texto); width: 230px; max-width: 60vw; outline: none;
}
.barra input#nombre:focus { border-color: var(--color-acento); }
.barra input#nombre.falta { border-color: var(--color-incorrecto); box-shadow: 0 0 0 3px rgba(139,26,26,.18); }
.barra .dato { color: var(--color-texto-suave); }
.barra .dato b { color: var(--color-acento); font-family: 'Libre Baskerville', serif; }
.aviso-nombre { color: var(--color-incorrecto); font-size: .82rem; font-weight: 700; display: none; width: 100%; text-align: center; }
.aviso-nombre.visible { display: block; }

/* ---------- Contenedor ---------- */
.ficha-container {
  max-width: 860px;
  margin: 28px auto;
  background: var(--color-fondo-card);
  border: 2px solid var(--color-borde);
  border-radius: 6px;
  box-shadow: 0 3px 12px rgba(44, 31, 14, 0.15);
  padding: 32px 36px;
}
.titulo-ficha {
  font-size: 1.6rem; text-align: center; margin: 0 0 4px;
}
.titulo-ficha::after {
  content: ''; display: block; width: 60px; height: 3px; background: var(--color-borde);
  margin: 10px auto 0; border-radius: 2px;
}
.subtitulo { text-align: center; color: var(--color-texto-suave); font-size: .92rem; margin: 6px 0 22px; }

.instrucciones {
  background: var(--color-fondo); border: 1px dashed var(--color-borde);
  border-radius: 4px; padding: 14px 18px; font-size: .92rem; color: var(--color-texto-suave);
  margin-bottom: 22px;
}
.instrucciones p { margin: 4px 0; }
.instrucciones kbd { font-family:'Lato',sans-serif; font-size:.8rem; border:1px solid var(--color-borde); border-bottom-width:2px; border-radius:3px; padding:0 5px; background: var(--color-fondo-card); color: var(--color-texto); }
.instrucciones code {
  font-family: 'Libre Baskerville', serif; background: var(--color-neutro);
  padding: 0 5px; border-radius: 3px; color: var(--color-texto);
}

/* Recordatorio de Sarrus */
details.recordatorio {
  border: 1px solid var(--color-borde-suave); border-radius: 4px; background: #fffdf8;
  padding: 8px 14px; margin-bottom: 24px; font-size: .92rem;
}
details.recordatorio summary {
  cursor: pointer; font-family: 'Libre Baskerville', serif; color: var(--color-acento); font-size: .9rem;
}
.sarrus-fig { display: flex; flex-wrap: wrap; gap: 26px; justify-content: center; margin: 12px 0 6px; }
.sarrus-fig figure { margin: 0; text-align: center; }
.sarrus-fig figcaption { font-size: .82rem; color: var(--color-texto-suave); margin-top: 4px; }

/* ---------- Ejercicios ---------- */
.ejercicio-card {
  background: var(--color-fondo);
  border: 1.5px solid var(--color-borde-suave);
  border-left: 4px solid var(--color-borde);
  border-radius: 4px;
  padding: 20px 24px;
  margin-bottom: 26px;
}
.ejercicio-card.bloqueado { border-left-color: var(--color-texto-suave); }
.ej-cab { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 6px; }
.ej-cab h2 { font-size: 1.1rem; margin: 0; }
.ej-puntos {
  font-family: 'Libre Baskerville', serif; font-size: .85rem; color: var(--color-acento);
  border: 1px solid var(--color-borde); border-radius: 12px; padding: 1px 10px; background: var(--color-fondo-card);
}
.ej-enunciado { color: var(--color-texto-suave); font-size: .95rem; margin: 8px 0 14px; }

.matriz-wrap { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 10px 0 18px; }
.matriz-wrap .nombre-det { font-family: 'Libre Baskerville', serif; font-size: 1.2rem; }
.det {
  display: grid; gap: 6px 22px; padding: 6px 14px;
  border-left: 2px solid var(--color-texto); border-right: 2px solid var(--color-texto);
  font-family: 'Libre Baskerville', serif; font-size: 1.25rem;
}
.det span { text-align: center; min-width: 2.6em; }
.det i { font-family: 'Libre Baskerville', serif; }

.pasos { display: grid; gap: 18px; }
.pasos.dos-col { grid-template-columns: 1fr 1fr; }
.grupo {
  background: var(--color-fondo-card); border: 1px solid var(--color-borde-suave); border-radius: 4px; padding: 12px 14px;
}
.grupo h3 { font-size: .92rem; margin: 0 0 8px; color: var(--color-texto-suave); font-weight: 700; }
.grupo h3 .signo { color: var(--color-acento); }
.celda { margin-bottom: 10px; }
.celda:last-child { margin-bottom: 0; }
.celda label { display: block; font-size: .8rem; color: var(--color-texto-suave); margin-bottom: 3px; }

input.resp {
  width: 100%;
  background-color: var(--color-fondo);
  border: 1.5px solid var(--color-borde);
  border-radius: 4px;
  padding: 8px 12px;
  font-family: 'Libre Baskerville', serif;
  font-size: 1rem;
  color: var(--color-texto);
  outline: none;
  transition: border-color .2s, background-color .2s;
}
input.resp:focus { border-color: var(--color-acento); }
input.resp:disabled { color: var(--color-texto); -webkit-text-fill-color: var(--color-texto); opacity: 1; }
input.resp.bien { border-color: var(--color-correcto); background: #EAF4EC; }
input.resp.mal  { border-color: var(--color-incorrecto); background: #F9EAEA; border-width: 2px; }
input.resp.vacia { border-color: var(--color-aviso); box-shadow: 0 0 0 3px rgba(183,121,31,.25); }
.nota-celda { font-size: .8rem; margin-top: 3px; min-height: 0; }
.nota-celda.mal { color: var(--color-incorrecto); }
.nota-celda.bien { color: var(--color-correcto); }

.resultado-fila {
  margin-top: 18px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  background: var(--color-fondo-card); border: 1.5px solid var(--color-borde); border-radius: 4px; padding: 12px 14px;
}
.resultado-fila .igual { font-family: 'Libre Baskerville', serif; font-size: 1.05rem; white-space: nowrap; }
.resultado-fila .celda { flex: 1; min-width: 200px; margin: 0; }

.teclado { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 12px; font-size: .8rem; color: var(--color-texto-suave); }
.tecla {
  font-family: 'Libre Baskerville', serif; font-size: .95rem;
  background: var(--color-fondo-card); border: 1px solid var(--color-borde); border-radius: 4px;
  padding: 3px 12px; cursor: pointer; color: var(--color-texto);
}
.tecla:hover { border-color: var(--color-acento); }
.tecla:disabled { opacity: .45; cursor: default; }

.acciones { margin-top: 16px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.btn-primario {
  background-color: var(--color-acento); color: #FDFAF3; border: none; border-radius: 4px;
  padding: 10px 22px; font-family: 'Lato', sans-serif; font-size: .95rem; font-weight: 700;
  cursor: pointer; letter-spacing: .03em; transition: background-color .2s ease;
}
.btn-primario:hover { background-color: var(--color-acento-hover); }
.btn-primario:disabled { background: var(--color-neutro); color: var(--color-texto-suave); cursor: default; }
.aviso-validacion { color: var(--color-aviso); font-size: .88rem; font-weight: 700; }

.feedback { margin-top: 16px; display: none; }
.feedback.visible { display: block; }
.feedback-correcto, .feedback-incorrecto { border-radius: 4px; padding: 12px 16px; }
.feedback-correcto { background: #EAF4EC; border: 1.5px solid var(--color-correcto); color: var(--color-correcto); }
.feedback-incorrecto { background: #F9EAEA; border: 1.5px solid var(--color-incorrecto); color: var(--color-incorrecto); }
.feedback .titular { font-weight: 700; margin-bottom: 4px; }
.feedback p { margin: 5px 0; color: var(--color-texto); }
.feedback ul { margin: 6px 0 4px 18px; padding: 0; color: var(--color-texto); }
.feedback li { margin: 3px 0; }
.solucion {
  margin-top: 10px; padding: 10px 12px; background: var(--color-fondo-card);
  border: 1px solid var(--color-borde-suave); border-radius: 4px; color: var(--color-texto);
  font-family: 'Libre Baskerville', serif; font-size: .92rem; overflow-x: auto;
}
.solucion .linea { white-space: nowrap; margin: 2px 0; }

/* ---------- Pie ---------- */
.pie { text-align: center; margin-top: 10px; padding-top: 22px; border-top: 1px solid var(--color-borde-suave); }
.btn-finalizar {
  background-color: var(--color-cabecera); color: var(--color-cabecera-txt);
  border: 2px solid var(--color-borde); border-radius: 4px; padding: 11px 26px;
  font-family: 'Libre Baskerville', serif; font-size: .95rem; font-weight: 700;
  cursor: pointer; letter-spacing: .04em; transition: background-color .2s;
}
.btn-finalizar:hover { background-color: #2C1A0A; }

/* ---------- Modal ---------- */
.overlay {
  position: fixed; inset: 0; background: rgba(44, 31, 14, 0.55);
  display: none; align-items: center; justify-content: center; z-index: 100; padding: 16px;
}
.overlay.visible { display: flex; }
.modal-calificacion {
  border: 3px solid var(--color-borde); border-radius: 8px;
  font-family: 'Libre Baskerville', serif; box-shadow: 0 6px 24px rgba(44, 31, 14, 0.35);
  padding: 28px 32px; width: min(520px, 100%); max-height: 92vh; overflow-y: auto; text-align: center;
}
.modal-titulo { font-size: 1.35rem; font-weight: 700; line-height: 1.3; }
.modal-sub { font-family: 'Lato', sans-serif; font-size: .85rem; opacity: .9; margin: 2px 0 12px; padding-bottom: 10px; border-bottom: 1px solid currentColor; }
.modal-calificacion h2 { margin: 0 0 6px; font-size: 1rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; color: inherit; }
.modal-nota { font-size: 3rem; font-weight: 700; margin: 6px 0 2px; }
.modal-datos { font-family: 'Lato', sans-serif; font-size: .92rem; margin: 10px 0 16px; line-height: 1.7; }
.tabla-informe {
  width: 100%; border-collapse: collapse; font-family: 'Lato', sans-serif; font-size: .86rem;
  background: rgba(255,255,255,.93); color: var(--color-texto); border-radius: 4px; overflow: hidden;
}
.tabla-informe th, .tabla-informe td { padding: 7px 8px; border-bottom: 1px solid var(--color-borde-suave); text-align: center; }
.tabla-informe th { background: var(--color-neutro); font-weight: 700; }
.tabla-informe td:first-child, .tabla-informe th:first-child { text-align: left; }
.btn-cerrar {
  margin-top: 18px; background: rgba(255,255,255,.92); color: var(--color-texto);
  border: 2px solid var(--color-borde); border-radius: 4px; padding: 8px 22px;
  font-family: 'Lato', sans-serif; font-weight: 700; cursor: pointer;
}

@media (max-width: 640px) {
  .ficha-container { margin: 14px 8px; padding: 20px 16px; }
  .pasos.dos-col { grid-template-columns: 1fr; }
  .det { gap: 6px 14px; font-size: 1.1rem; }
  .ejercicio-card { padding: 16px 14px; }
}
</style>
</head>
<body>

<div class="cabecera">Material elaborado por Marta L Letona S. Basado en el trabajo de Javier Cayetano</div>


<main class="ficha-container">
  <h1 class="titulo-ficha">Cálculo de determinantes</h1>
  <p class="subtitulo">2.º Bachillerato · Matrices y determinantes</p>

  <div class="barra">
    <label for="nombre">Alumno/a:</label>
    <input type="text" id="nombre" placeholder="Nombre y apellidos" autocomplete="off">
    <span class="dato">Nota: <b id="marcador-nota">0</b> / 10</span>
    <span class="dato">Corregidos: <b id="marcador-corr">0</b> / 3</span>
    <div class="aviso-nombre" id="aviso-nombre">Escribe tu nombre antes de continuar.</div>
  </div>

  <div class="instrucciones">
    <p>Calcula cada determinante. Escribe primero los <strong>productos intermedios</strong> y después el <strong>resultado</strong>.</p>
    <p>Cada ejercicio se corrige <strong>una sola vez</strong>: al pulsar «Corregir» queda bloqueado. La puntuación depende del resultado final; los pasos sirven para localizar dónde está el error.</p>
    <p>Con <kbd>Intro</kbd> pasas a la casilla siguiente. Para escribir la letra usa <code>a</code>; para las potencias, los botones <code>a²</code> <code>a³</code> o bien <code>a^2</code>. Ejemplos válidos: <code>−6a²</code>, <code>4a³ − 2a + 7</code>, <code>−12</code>.</p>
  </div>

  <details class="recordatorio">
    <summary>Recordatorio: regla de Sarrus (determinantes 3×3)</summary>
    <div class="sarrus-fig">
      <figure>
        <svg width="150" height="130" viewBox="0 0 150 130" aria-label="Productos que suman">
          <g fill="none" stroke-width="2.2" stroke-linejoin="round">
            <line x1="35" y1="25" x2="115" y2="105" stroke="#A0522D"/>
            <polygon points="75,25 115,65 35,105" stroke="#C9A96E"/>
            <polygon points="115,25 35,65 75,105" stroke="#6B4F35" stroke-dasharray="5 4"/>
          </g>
          <g fill="#2C1F0E">
            <circle cx="35" cy="25" r="5"/><circle cx="75" cy="25" r="5"/><circle cx="115" cy="25" r="5"/>
            <circle cx="35" cy="65" r="5"/><circle cx="75" cy="65" r="5"/><circle cx="115" cy="65" r="5"/>
            <circle cx="35" cy="105" r="5"/><circle cx="75" cy="105" r="5"/><circle cx="115" cy="105" r="5"/>
          </g>
        </svg>
        <figcaption>Productos que <strong>suman</strong> (+)</figcaption>
      </figure>
      <figure>
        <svg width="150" height="130" viewBox="0 0 150 130" aria-label="Productos que restan">
          <g fill="none" stroke-width="2.2" stroke-linejoin="round">
            <line x1="115" y1="25" x2="35" y2="105" stroke="#A0522D"/>
            <polygon points="35,25 115,65 75,105" stroke="#C9A96E"/>
            <polygon points="75,25 35,65 115,105" stroke="#6B4F35" stroke-dasharray="5 4"/>
          </g>
          <g fill="#2C1F0E">
            <circle cx="35" cy="25" r="5"/><circle cx="75" cy="25" r="5"/><circle cx="115" cy="25" r="5"/>
            <circle cx="35" cy="65" r="5"/><circle cx="75" cy="65" r="5"/><circle cx="115" cy="65" r="5"/>
            <circle cx="35" cy="105" r="5"/><circle cx="75" cy="105" r="5"/><circle cx="115" cy="105" r="5"/>
          </g>
        </svg>
        <figcaption>Productos que <strong>restan</strong> (−)</figcaption>
      </figure>
    </div>
    <p style="margin:6px 0 2px;">det(A) = (suma de los tres productos que suman) − (suma de los tres productos que restan).</p>
  </details>

  <div id="ejercicios"></div>

  <div class="pie">
    <button class="btn-finalizar" id="btn-finalizar" type="button">Finalizar y Calificar</button>
  </div>
</main>

<div class="overlay" id="overlay" role="dialog" aria-modal="true">
  <div class="modal-calificacion" id="modal"></div>
</div>

<script>
/* =========================================================
   Semilla: aleatoria en producción; ?seed=N solo para QA
   ========================================================= */
const params = new URLSearchParams(location.search);
const SEED = params.has('seed') ? (parseInt(params.get('seed'), 10) >>> 0) : ((Math.random() * 2 ** 32) >>> 0);
function mulberry32(a) {
  return function () {
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}
const rng = mulberry32(SEED);
const randInt = (lo, hi) => lo + Math.floor(rng() * (hi - lo + 1));
const randNZ = (lo, hi) => { let v; do { v = randInt(lo, hi); } while (v === 0); return v; };
const shuffle = arr => { const a = arr.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(rng() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };

/* =========================================================
   Polinomios en a: array de coeficientes, índice = exponente
   ========================================================= */
const DEG = 9;
const P0 = () => new Array(DEG + 1).fill(0);
const mono = (c, e) => { const p = P0(); p[e] = c; return p; };
const add = (p, q) => p.map((v, i) => v + q[i]);
const neg = p => p.map(v => (v === 0 ? 0 : -v));
const sub = (p, q) => add(p, neg(q));
const mul = (p, q) => {
  const r = P0();
  for (let i = 0; i <= DEG; i++) if (p[i]) for (let j = 0; j + i <= DEG; j++) if (q[j]) r[i + j] += p[i] * q[j];
  return r;
};
const eq = (p, q) => p.every((v, i) => v === q[i]);
const isZero = p => p.every(v => v === 0);
const degree = p => { for (let i = DEG; i >= 0; i--) if (p[i]) return i; return -1; };
const nTerms = p => p.filter(v => v !== 0).length;
const sumAll = list => list.reduce((acc, p) => add(acc, p), P0());

/* Formato HTML con a en cursiva y exponentes voladitos */
function fmt(p) {
  const parts = [];
  for (let e = DEG; e >= 0; e--) {
    const c = p[e];
    if (!c) continue;
    const abs = Math.abs(c);
    let body;
    if (e === 0) body = String(abs);
    else body = (abs === 1 ? '' : abs) + '<i>a</i>' + (e >= 2 ? '<sup>' + e + '</sup>' : '');
    parts.push({ sign: c < 0 ? '−' : '+', body });
  }
  if (!parts.length) return '0';
  return parts.map((t, i) => (i === 0 ? (t.sign === '−' ? '−' : '') + t.body : ' ' + t.sign + ' ' + t.body)).join('');
}
/* Entre paréntesis si es negativo o tiene varios términos */
function fmtPar(p) {
  const s = fmt(p);
  return (nTerms(p) > 1 || s.startsWith('−')) ? '(' + s + ')' : s;
}

/* Lector tolerante: −6a², -6a^2, -6a2, 6·a², (−12), 4a³ − 2a + 7 */
function parsePoly(str) {
  let s = String(str).trim().toLowerCase();
  if (!s) return null;
  s = s.replace(/[−–—]/g, '-').replace(/[·*×\s]/g, '')
       .replace(/¹/g, '^1').replace(/²/g, '^2').replace(/³/g, '^3');
  while (/^\(.*\)$/.test(s)) s = s.slice(1, -1);
  if (!s) return null;
  if (!/^[+-]/.test(s)) s = '+' + s;
  const re = /([+-])(\d*)(a(?:\^?(\d+))?)?/y;
  const res = P0();
  let pos = 0;
  while (pos < s.length) {
    re.lastIndex = pos;
    const m = re.exec(s);
    if (!m || m[0].length <= 1) return null;
    const hasA = !!m[3];
    if (!m[2] && !hasA) return null;
    const c = m[2] ? parseInt(m[2], 10) : 1;
    const e = hasA ? (m[4] ? parseInt(m[4], 10) : 1) : 0;
    if (e > DEG) return null;
    res[e] += (m[1] === '-' ? -1 : 1) * c;
    pos = re.lastIndex;
  }
  return res;
}

/* =========================================================
   Generación de ejercicios
   ========================================================= */
const PLUS = [[[0, 0], [1, 1], [2, 2]], [[0, 1], [1, 2], [2, 0]], [[0, 2], [1, 0], [2, 1]]];
const MINUS = [[[0, 2], [1, 1], [2, 0]], [[0, 0], [1, 2], [2, 1]], [[0, 1], [1, 0], [2, 2]]];
const prodOf = (M, idx) => idx.reduce((acc, [r, c]) => mul(acc, M[r][c]), mono(1, 0));

function gen2x2() {
  for (let intento = 0; intento < 500; intento++) {
    const k = [1, 2, 2, 2, 3][randInt(0, 4)];
    const conA = new Set(shuffle([0, 1, 2, 3]).slice(0, k));
    const M = [[null, null], [null, null]];
    for (let i = 0; i < 4; i++) {
      const r = Math.floor(i / 2), c = i % 2;
      M[r][c] = conA.has(i) ? mono(randNZ(-5, 5), 1) : mono(randNZ(-6, 6), 0);
    }
    const principal = mul(M[0][0], M[1][1]);
    const secundaria = mul(M[0][1], M[1][0]);
    const det = sub(principal, secundaria);
    if (isZero(det) || degree(det) < 1 || eq(principal, secundaria)) continue;
    return { M, pasos: { principal, secundaria }, det };
  }
}

function gen3x3int() {
  for (let intento = 0; intento < 500; intento++) {
    const M = [];
    let ceros = 0;
    for (let r = 0; r < 3; r++) {
      M.push([]);
      for (let c = 0; c < 3; c++) {
        const v = randInt(-5, 5);
        if (v === 0) ceros++;
        M[r].push(mono(v, 0));
      }
    }
    if (ceros > 1) continue;
    const suman = PLUS.map(t => prodOf(M, t));
    const restan = MINUS.map(t => prodOf(M, t));
    const det = sub(sumAll(suman), sumAll(restan));
    if (isZero(det)) continue;
    return { M, suman, restan, det };
  }
}

function gen3x3a() {
  for (let intento = 0; intento < 2000; intento++) {
    const k = randInt(3, 4);
    const conA = new Set(shuffle([0, 1, 2, 3, 4, 5, 6, 7, 8]).slice(0, k));
    const M = [];
    let ceros = 0;
    for (let r = 0; r < 3; r++) {
      M.push([]);
      for (let c = 0; c < 3; c++) {
        const i = r * 3 + c;
        if (conA.has(i)) M[r].push(mono(randNZ(-3, 3), 1));
        else {
          const v = randInt(-4, 4);
          if (v === 0) ceros++;
          M[r].push(mono(v, 0));
        }
      }
    }
    if (ceros > 1) continue;
    const suman = PLUS.map(t => prodOf(M, t));
    const restan = MINUS.map(t => prodOf(M, t));
    const det = sub(sumAll(suman), sumAll(restan));
    if (isZero(det) || degree(det) < 2 || nTerms(det) < 2) continue;
    return { M, suman, restan, det };
  }
}

