function leer(ids) {
  let faltan = 0;
  const vals = ids.map(id => {
    const inp = document.getElementById(id);
    const p = parsePoly(inp.value);
    if (!p) { inp.classList.add('vacia'); faltan++; }
    return p;
  });
  return { vals, faltan };
}

function corregir(n) {
  const E = EJ[n], S = state.ej[n];
  if (S.corregido) return;
  if (!exigirNombre()) return;

  const aviso = document.getElementById('aviso-' + n);
  const conLetra = n !== 2;
  const idsPasos = E.tipo === '2x2' ? ['e1-p', 'e1-s'] : ['s1', 's2', 's3', 'r1', 'r2', 'r3'].map(x => 'e' + n + '-' + x);
  const idRes = 'e' + n + '-res';
  const { vals, faltan } = leer([...idsPasos, idRes]);
  if (faltan) {
    aviso.textContent = faltan === 1
      ? 'Hay una casilla vacía o que no se entiende. Revísala: el intento no se ha consumido.'
      : 'Hay ' + faltan + ' casillas vacías o que no se entienden. Revísalas: el intento no se ha consumido.';
    return;
  }
  aviso.textContent = '';

  const D = E.datos;
  const res = vals[vals.length - 1];
  let pasosOk = 0, sumaMas, sumaMenos, implicito, negada = false, lineas = [];
  const erroresPasos = [];

  if (E.tipo === '2x2') {
    const [p, s] = vals;
    const okP = eq(p, D.pasos.principal);
    pintarCelda('e1-p', okP, okP ? '' : tipoError(p, D.pasos.principal, false, true), D.pasos.principal);
    if (okP) pasosOk++; else erroresPasos.push('diagonal principal');

    negada = !eq(s, D.pasos.secundaria) && eq(s, neg(D.pasos.secundaria));
    const okS = eq(s, D.pasos.secundaria) || negada;
    pintarCelda('e1-s', okS, okS ? '' : tipoError(s, D.pasos.secundaria, true, true), D.pasos.secundaria,
      negada ? 'Lo has escrito ya con el signo cambiado: vale si al final lo sumas.' : '');
    if (okS) pasosOk++; else erroresPasos.push('diagonal secundaria');

    sumaMas = D.pasos.principal; sumaMenos = D.pasos.secundaria;
    implicito = negada ? add(p, s) : sub(p, s);
    lineas = [
      '|A| = ' + fmtPar(D.M[0][0]) + '·' + fmtPar(D.M[1][1]) + ' − ' + fmtPar(D.M[0][1]) + '·' + fmtPar(D.M[1][0]),
      '&nbsp;&nbsp;&nbsp;&nbsp;= ' + fmt(D.pasos.principal) + ' − ' + fmtPar(D.pasos.secundaria),
      '&nbsp;&nbsp;&nbsp;&nbsp;= <strong>' + fmt(D.det) + '</strong>'
    ];
  } else {
    const sEst = vals.slice(0, 3), rEst = vals.slice(3, 6);
    const evS = evaluarGrupo(sEst, D.suman, false, conLetra);
    negada = !evaluarGrupo(rEst, D.restan, true, conLetra).every(x => x.ok) && columnaNegada(rEst, D.restan);
    const evR = negada ? rEst.map(x => ({ ok: true })) : evaluarGrupo(rEst, D.restan, true, conLetra);
    evS.forEach((e, i) => { pintarCelda('e' + n + '-s' + (i + 1), e.ok, e.msg, e.correcto); if (e.ok) pasosOk++; });
    evR.forEach((e, i) => {
      pintarCelda('e' + n + '-r' + (i + 1), e.ok, e.msg, e.correcto,
        negada && i === 0 ? 'Columna escrita con el signo ya cambiado: vale si al final la sumas.' : '');
      if (e.ok) pasosOk++;
    });
    if (evS.some(e => !e.ok)) erroresPasos.push('productos que suman');
    if (evR.some(e => !e.ok)) erroresPasos.push('productos que restan');

    sumaMas = sumAll(D.suman); sumaMenos = sumAll(D.restan);
    implicito = negada ? add(sumAll(sEst), sumAll(rEst)) : sub(sumAll(sEst), sumAll(rEst));
    lineas = [
      '|A| = [' + D.suman.map(fmtPar).join(' + ') + '] − [' + D.restan.map(fmtPar).join(' + ') + ']',
      '&nbsp;&nbsp;&nbsp;&nbsp;= ' + fmtPar(sumaMas) + ' − ' + fmtPar(sumaMenos),
      '&nbsp;&nbsp;&nbsp;&nbsp;= <strong>' + fmt(D.det) + '</strong>'
    ];
  }

  // Resultado: es lo único que puntúa
  const okRes = eq(res, D.det);
  pintarCelda(idRes, okRes, '', D.det);
  S.resultadoOk = okRes;
  S.pasosOk = pasosOk;
  S.puntos = okRes ? E.max : 0;
  S.corregido = true;

  // Feedback pedagógico
  let fb = '';
  const concepto = E.tipo === '2x2'
    ? 'En un 2×2, el determinante es el producto de la diagonal principal menos el de la secundaria.'
    : (conLetra
        ? 'Con Sarrus, cada producto toma un elemento de cada fila y de cada columna; con letras, se suman exponentes y al final se agrupan términos semejantes.'
        : 'Con Sarrus, cada producto toma exactamente un elemento de cada fila y de cada columna.');

  if (okRes) {
    fb = '<div class="feedback-correcto"><div class="titular">✔ Resultado correcto: +' + E.max + ' puntos</div>';
    if (pasosOk === S.pasosTotal) fb += '<p>Todo el procedimiento es correcto. ' + concepto + '</p>';
    else fb += '<p>El resultado es correcto, pero hay alguna casilla intermedia mal (en rojo). Revísala: un resultado bien obtenido con pasos mal escritos suele ser casualidad o un error de escritura.</p>';
  } else {
    fb = '<div class="feedback-incorrecto"><div class="titular">✘ Resultado incorrecto: 0 puntos</div><ul>';
    const sumado = E.tipo === '2x2' ? add(D.pasos.principal, D.pasos.secundaria) : add(sumaMas, sumaMenos);
    if (!negada && eq(res, sumado)) {
      fb += '<li>Has <strong>sumado</strong> el segundo bloque en lugar de <strong>restarlo</strong>. ' +
        (E.tipo === '2x2' ? 'El producto de la diagonal secundaria se resta.' : 'Los tres productos de la segunda columna se restan todos.') + '</li>';
    } else if (pasosOk === S.pasosTotal) {
      fb += '<li>Tus productos son correctos: el fallo está al <strong>reunirlos</strong>. ' +
        (conLetra
          ? 'Al restar un paréntesis cambia el signo de cada término que contiene; después agrupa los términos semejantes (<i>a</i><sup>3</sup> con <i>a</i><sup>3</sup>, <i>a</i><sup>2</sup> con <i>a</i><sup>2</sup>…).'
          : 'Revisa la suma de cada bloque y la resta final, con cuidado con los signos.') + '</li>';
    } else if (eq(res, implicito)) {
      fb += '<li>Tu resultado es <strong>coherente con tus productos</strong>: el error viene arrastrado de las casillas en rojo (' + erroresPasos.join(' y ') + '). El planteamiento final es correcto.</li>';
    } else {
      if (erroresPasos.length) fb += '<li>Hay errores en: ' + erroresPasos.join(' y ') + ' (casillas en rojo, con el motivo debajo de cada una).</li>';
      fb += '<li>Además, el resultado no coincide con lo que dan tus propios productos: revisa también la operación final' + (conLetra ? ' y la agrupación de términos semejantes' : '') + '.</li>';
    }
    fb += '</ul><p>' + concepto + '</p>';
  }
  fb += '<div class="solucion"><div style="font-family:Lato,sans-serif;font-size:.8rem;color:#6B4F35;margin-bottom:4px;">Resolución completa</div>' +
    lineas.map(l => '<div class="linea">' + l + '</div>').join('') + '</div></div>';

  const fbEl = document.getElementById('fb-' + n);
  fbEl.innerHTML = fb;
  fbEl.classList.add('visible');

  // Bloqueo definitivo
  document.querySelectorAll('#card-' + n + ' input.resp, #card-' + n + ' .tecla').forEach(el => { el.disabled = true; });
  const btn = document.getElementById('btn-' + n);
  btn.disabled = true;
  btn.textContent = 'Corregido · bloqueado';
  document.getElementById('card-' + n).classList.add('bloqueado');

  actualizarMarcador();
}

function actualizarMarcador() {
  state.nota = [1, 2, 3].reduce((acc, n) => acc + state.ej[n].puntos, 0);
  document.getElementById('marcador-nota').textContent = state.nota;
  document.getElementById('marcador-corr').textContent = [1, 2, 3].filter(n => state.ej[n].corregido).length;
}

