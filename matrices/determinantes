function colorNota(nota) {
  const f = Math.floor(nota + 1e-9);
  if (f >= 10) return ['#1a7a1a', '#fff'];
  if (f === 9) return ['#6dbf6d', '#fff'];
  if (f === 8) return ['#1a4f8a', '#fff'];
  if (f === 7) return ['#5b9bd5', '#fff'];
  if (f === 6) return ['#c05c00', '#fff'];
  if (f === 5) return ['#f5a623', '#000'];
  return ['#c0392b', '#fff'];
}
