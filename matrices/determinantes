/* =========================================================
   Diagnóstico de productos
   ========================================================= */
function tipoError(s, c, enResta, conLetra) {
  if (eq(s, neg(c))) {
    return enResta
      ? 'Signo cambiado. En esta columna va el producto tal cual; el «−» se aplica después, al restar. Revisa también la regla de los signos.'
      : 'Error de signo: revisa la regla de los signos (− · − = +, − · + = −).';
  }
  if (nTerms(s) > 1) return 'Un producto de elementos es un solo término (monomio): no puede tener sumas.';
  if (conLetra && degree(s) === degree(c) && degree(s) >= 0) return 'Error al multiplicar los coeficientes numéricos.';
  if (conLetra && degree(s) !== degree(c)) {
    const cs = s[Math.max(degree(s), 0)], cc = c[Math.max(degree(c), 0)];
    if (Math.abs(cs) === Math.abs(cc)) return 'Error con la potencia de <i>a</i>: al multiplicar se suman los exponentes (<i>a</i>·<i>a</i> = <i>a</i><sup>2</sup>, <i>a</i>·<i>a</i><sup>2</sup> = <i>a</i><sup>3</sup>).';
    return 'No coincide con ningún producto de esta columna: comprueba qué tres elementos se multiplican y cuántas veces aparece la letra.';
  }
  return conLetra ? 'Error al calcular el producto.' : 'Error de cálculo en el producto: revisa la multiplicación y los signos.';
}
function distancia(s, c) {
  if (eq(s, neg(c))) return 0;
  if (degree(s) === degree(c)) return 1;
  return 2;
}
function permutaciones(arr) {
  if (arr.length <= 1) return [arr];
  return arr.flatMap((x, i) => permutaciones(arr.filter((_, j) => j !== i)).map(p => [x, ...p]));
}
/* Empareja las 3 casillas de una columna con los 3 productos correctos, sin importar el orden */
function evaluarGrupo(estudiante, correctos, enResta, conLetra) {
  const out = estudiante.map(() => ({ ok: false, correcto: null, msg: '' }));
  const libres = correctos.map((_, j) => j);
  const sinPar = [];
  estudiante.forEach((s, i) => {
    const k = libres.findIndex(j => eq(correctos[j], s));
    if (k >= 0) { out[i].ok = true; out[i].correcto = correctos[libres[k]]; libres.splice(k, 1); }
    else sinPar.push(i);
  });
  if (sinPar.length) {
    let mejor = null, coste = Infinity;
    for (const perm of permutaciones(libres)) {
      const cst = sinPar.reduce((acc, i, t) => acc + distancia(estudiante[i], correctos[perm[t]]), 0);
      if (cst < coste) { coste = cst; mejor = perm; }
    }
    sinPar.forEach((i, t) => {
      const c = correctos[mejor[t]];
      out[i].correcto = c;
      out[i].msg = tipoError(estudiante[i], c, enResta, conLetra);
    });
  }
  return out;
}
/* ¿El alumno escribió TODA la columna «restan» ya con el signo cambiado? Es un método válido. */
function columnaNegada(estudiante, correctos) {
  const negados = correctos.map(neg);
  const libres = negados.slice();
  for (const s of estudiante) {
    const k = libres.findIndex(c => eq(c, s));
    if (k < 0) return false;
    libres.splice(k, 1);
  }
  return !correctos.every(isZero);
}

function pintarCelda(id, ok, msg, correcto, aviso) {
  const inp = document.getElementById(id), nota = document.getElementById(id + '-nota');
  inp.classList.remove('bien', 'mal', 'vacia');
  inp.classList.add(ok ? 'bien' : 'mal');
  nota.className = 'nota-celda ' + (ok ? 'bien' : 'mal');
  if (ok) nota.innerHTML = aviso || '';
  else nota.innerHTML = 'Debía ser: <strong>' + fmt(correcto) + '</strong>' + (msg ? '<br>' + msg : '');
}

